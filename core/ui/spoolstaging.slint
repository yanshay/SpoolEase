import { MyText, MyButton } from "framework/widgets.slint";
import { AppState, AppConsts, AppBackend, SpoolStagingState, ControlState, SpoolScaleState, StagingOperationsPage } from "app.slint";
import { Utils } from "utils.slint"; 
import { FrameworkState } from "framework/framework.slint";

export component SpoolStaging inherits Rectangle {
    callback clicked-ota;

    main := VerticalLayout {
        spacing: AppConsts.trays-spacing;
        title := Rectangle {
            background: AppConsts.title-gradient;
            height: 30px;
            Text {
                color: white; // Utils.contrasting_color(parent.background); // entered manually white because this cause a panic in slint for some reason
                text: AppState.spool-staging-state == SpoolStagingState.Empty ? "Staging" : AppState.spool-staging-state == SpoolStagingState.Scanned ? "Scanned" : AppState.spool-staging-state == SpoolStagingState.Encoded ? "Encoded" : "Unloaded";
                font-size: 20px;
            }

            title-border := Rectangle {
                border-color: black;
                border-width: 1px;
            }
        }

        Rectangle {
            filament-box := Rectangle {
                pure function representative-color-index(color-count: int) -> int {
                    if color-count <= 1 {
                        return 0;
                    }
                    if color-count == 2 {
                        return 1;
                    }
                    return (color-count - 1) / 2;
                }
                property <int> staging-color-count: AppState.spool-staging-info.colors.length;
                property <color> representative-color: staging-color-count > 0 ? AppState.spool-staging-info.colors[representative-color-index(staging-color-count)] : AppState.spool-staging-info.color;
                property <color> staging-text-color: Utils.contrasting_color(representative-color);
                property <length> staging-stripe-width: staging-color-count > 0 ? self.width / staging-color-count : self.width;
                background: AppState.spool-staging-state == SpoolStagingState.Empty ? AppConsts.no-color : #00000000;

                if AppState.spool-staging-state != SpoolStagingState.Empty
                    && ((staging-color-count == 0 && AppState.spool-staging-info.color.alpha < 255)
                        || (staging-color-count > 0 && AppState.spool-staging-info.colors-has-alpha)): Image {
                    image-fit: preserve;
                    horizontal-alignment: left;
                    vertical-alignment: top;
                    width: parent.width;
                    height: parent.height;
                    source: AppState.color-checkerboard-bg;
                }

                if AppState.spool-staging-state != SpoolStagingState.Empty && staging-color-count > 0: HorizontalLayout {
                    width: parent.width;
                    height: parent.height;
                    spacing: 0px;
                    for stripe-color in AppState.spool-staging-info.colors: Rectangle {
                        horizontal-stretch: 1;
                        background: stripe-color;
                    }
                }

                if AppState.spool-staging-state != SpoolStagingState.Empty && staging-color-count == 0: Rectangle {
                    width: parent.width;
                    height: parent.height;
                    background: AppState.spool-staging-info.color;
                }

                if AppState.spool-staging-state != SpoolStagingState.Empty && staging-color-count > 0: HorizontalLayout {
                    width: parent.width;
                    height: parent.height;
                    spacing: 0px;

                    for stripe-color[idx] in AppState.spool-staging-info.colors: Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;
                        clip: filament-box.staging-color-count > 1;

                        VerticalLayout {
                            x: -idx * filament-box.staging-stripe-width;
                            width: filament-box.width;
                            height: filament-box.height;
                            alignment: space-around;
                            padding-top: 8px;
                            padding-bottom: 8px;

                            if AppState.spool-staging-info.spool-record.id != "": Text {
                                horizontal-alignment: center;
                                font-size: 20px;
                                text: AppState.spool-staging-info.spool-record.id != "" ? "ID: \{AppState.spool-staging-info.spool-record.id}" : "";
                                color: Utils.contrasting_color(stripe-color);
                            }

                            Text {
                                horizontal-alignment: center;
                                font-size: 20px;
                                text: AppState.spool-staging-info.spool-record.material-type;
                                color: Utils.contrasting_color(stripe-color);
                            }

                            if AppState.spool-staging-info.weight-left != "": Text {
                                horizontal-alignment: center;
                                font-size: 20px;
                                text: AppState.spool-staging-info.weight-left;
                                color: Utils.contrasting_color(stripe-color);
                            }

                            if AppState.spool-staging-info.weight-left == "": Text {
                                horizontal-alignment: center;
                                font-size: 20px;
                                text: "K: " + (AppState.spool-staging-info.spool-record.ext-has-k ? "✔" : "-");
                                color: Utils.contrasting_color(stripe-color);
                            }
                        }
                    }
                }

                if AppState.spool-staging-state != SpoolStagingState.Empty && staging-color-count == 0: VerticalLayout {
                    alignment: space-around;
                    padding-top: 8px;
                    padding-bottom: 8px;

                    if AppState.spool-staging-info.spool-record.id != "": Text {
                        horizontal-alignment: center;
                        font-size: 20px;
                        text: AppState.spool-staging-info.spool-record.id != "" ? "ID: \{AppState.spool-staging-info.spool-record.id}" : "";
                        color: filament-box.staging-text-color;
                    }

                    Text {
                        horizontal-alignment: center;
                        font-size: 20px;
                        text: AppState.spool-staging-info.spool-record.material-type;
                        color: filament-box.staging-text-color;
                    }

                    if AppState.spool-staging-info.weight-left != "": Text {
                        horizontal-alignment: center;
                        font-size: 20px;
                        text: AppState.spool-staging-info.weight-left;
                        color: filament-box.staging-text-color;
                    }

                    if AppState.spool-staging-info.weight-left == "": Text {
                        horizontal-alignment: center;
                        font-size: 20px;
                        text: "K: " + (AppState.spool-staging-info.spool-record.ext-has-k ? "✔" : "-");
                        color: filament-box.staging-text-color;
                    }
                }
            }

            if (AppState.spool-staging-state == SpoolStagingState.Empty && (AppState.stable-firmware-updates-available() || AppState.unstable-firmware-updates-available())): 
            Rectangle {
                width: parent.width;
                height: parent.height;

                MyText {
                    color: lightgreen;
                    horizontal-alignment: center;
                    vertical-alignment: center;

                    text: AppState.stable-firmware-updates-available() ? "Updates\nAvailable" : "Beta\nUpdates\nAvailable";
                }
            }

            filament-box-border := Rectangle {
                width: parent.width;
                height: parent.height;
                border-color: black;
                border-width: 1px;
            }
        }
    }

    if (AppState.highlight-tray == 999 && AppState.highlight-tray-flash) || (AppState.highlight-staging): highlight-border := Rectangle {
        width: parent.width;
        height: parent.height;
        border-width: 4px;
        border-color: AppState.spool-staging-state == SpoolStagingState.Empty ? black : Utils.contrasting_color(filament-box.representative-color);
    }

    area := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => {
            AppState.staging-selected();
            if AppState.spool-staging-state == SpoolStagingState.Empty {
                AppState.clear_tag_scanned();
                AppState.staging-operation-page = StagingOperationsPage.SelectSpoolToLoad;
            }
        }
    }
}
