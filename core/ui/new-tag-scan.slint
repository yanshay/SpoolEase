import {
    MyText,
    MyButton,
    ButtonType,
    WizardButtons,
    Title,
} from "framework/widgets.slint";
import { NumPad } from "numpad.slint";
import {
    AppBackend,
    AppState,
    ControlState,
    NewTagScanPage,
    NewTagOperation,
    SpoolScaleState,
    UiSpoolRecordDisplay,
    UiSpoolMatch,
    UiTagDiff,
    NewScannedTagType,
} from "app.slint";
import { Utils } from "utils.slint";
import { ScaleWeightDisplay, WeightDisplayContent } from "app-widgets.slint";
import { SpoolDisplay, SpoolDisplayMode } from "spool-display.slint";
import { UpdateWeightPage } from "common-operations.slint";

enum DefinitionTagChoice { AddNew, LinkExisting }

// One question: the default is highlighted so Next alone accepts it (next-next-next through
// the common path), and tapping either option acts immediately without a second press.
export component DefinitionTagScannedPage inherits Rectangle {
    background: white;
    property <DefinitionTagChoice> choice: DefinitionTagChoice.AddNew;

    function go(picked: DefinitionTagChoice) {
        choice = picked;
        AppState.new-tag-scan-page = picked == DefinitionTagChoice.AddNew
            ? NewTagScanPage.SpoolTypeSelect
            : NewTagScanPage.SpoolPicker;
    }

    VerticalLayout {
        Title {
            text: "New \{AppState.new-tag-scan-definition-type} Tag Scanned";
        }
        VerticalLayout {
            alignment: start;
            padding: 5px;
            padding-top: 10px;
            spacing: 8px;
            MyText {
                wrap: word-wrap;
                text: "This tag isn't in your inventory.";
                color: black;
            }

            MyButton {
                type: ButtonType.RadioButton;
                pushed: choice == DefinitionTagChoice.AddNew;
                height: 56px;
                text: "Add as New Spool";
                pressed => { go(DefinitionTagChoice.AddNew); }
            }

            MyButton {
                type: ButtonType.RadioButton;
                pushed: choice == DefinitionTagChoice.LinkExisting;
                height: 56px;
                text: "Link Tag to Existing Spool" + (AppState.new-tag-scan-product-match-count > 0 ? " (\{AppState.new-tag-scan-product-match-count} matching)" : "");
                pressed => { go(DefinitionTagChoice.LinkExisting); }
            }
        }
        WizardButtons {
            back-enabled: false;
            next-enabled: true;
            cancel-text: "⌂ Home";
            next-clicked => { go(choice); }
            cancel-clicked => { AppState.control-state = ControlState.Ready; }
        }
    }
}

enum BambulabSpoolTypeSelection {
  None,
  LowTemp,
  HighTemp,
  Other,
}
enum NewOrUsedSelection {
  None,
  New,
  Used,
}

export component SpoolTypePage inherits Rectangle {
    background: white;
    property <BambulabSpoolTypeSelection> spool-selection: AppBackend.default-spool-type-is-low-temp(AppState.new-tag-scan-definition-type, AppState.new-tag-scan-definition-info) ? BambulabSpoolTypeSelection.LowTemp : BambulabSpoolTypeSelection.HighTemp;
    property <NewOrUsedSelection> spool-new-or-used: NewOrUsedSelection.New;
    property <bool> submitting: false;
    // Bambu asks two questions (core weight + state), so a tap on either can only answer one of
    // them - the user must press Next to say both are answered. Elsewhere only state is asked, so
    // a tap is the whole answer and commits. Next stays either way, accepting the highlighted
    // defaults, so the common path is still next-next-next.
    property <bool> two-questions: AppState.new-tag-scan-definition-type == "Bambu Lab";

    function submit() {
        if !submitting {
            submitting = true;
            AppState.new-tag-scan-empty-spool-weight = two-questions
                ? (spool-selection == BambulabSpoolTypeSelection.LowTemp ? 250 : spool-selection == BambulabSpoolTypeSelection.HighTemp ? 260 : 0)
                : 0;
            AppState.new-tag-scan-spool-is-full = spool-new-or-used == NewOrUsedSelection.New;
            AppBackend.import-definition-tag-to-inventory(
                AppState.new-tag-scan-tag-id,
                AppState.new-tag-scan-definition-type,
                AppState.new-tag-scan-definition-info,
                AppState.new-tag-scan-empty-spool-weight,
                AppState.new-tag-scan-spool-is-full
            );
        }
    }

    VerticalLayout {
        Title {
            text: "New \{AppState.new-tag-scan-definition-type} Tag Scanned";
        }
        VerticalLayout {
            alignment: start;
            padding: 5px;
            padding-top: 5px;
            spacing: 5px;

            if two-questions: VerticalLayout {
                spacing: 2px;
                MyText {
                    text: "What spool type is used with this tag?";
                }
                VerticalLayout {
                    spacing: -1px;
                    MyButton {
                        type: ButtonType.RadioButton;
                        pushed: spool-selection == BambulabSpoolTypeSelection.LowTemp;
                        height: 38px;
                        text: "Low Temp (≤ 70°C) / Light Gray (~250g)";
                        pressed => { spool-selection = BambulabSpoolTypeSelection.LowTemp; }
                    }
                    MyButton {
                        type: ButtonType.RadioButton;
                        pushed: spool-selection == BambulabSpoolTypeSelection.HighTemp;
                        height: 38px;
                        text: "High Temp (≤ 90°C) / Dark Gray (~260g)";
                        pressed => { spool-selection = BambulabSpoolTypeSelection.HighTemp; }
                    }
                    MyButton {
                        type: ButtonType.RadioButton;
                        pushed: spool-selection == BambulabSpoolTypeSelection.Other;
                        height: 38px;
                        text: "Other (Can be entered manually later)";
                        pressed => { spool-selection = BambulabSpoolTypeSelection.Other; }
                    }
                }
            }

            MyText {
                text: two-questions ? "What's the state of this spool filament?" : "What's the state of this spool filament? (tap to add it)";
            }

            HorizontalLayout {
                spacing: -1px;
                MyButton {
                    type: ButtonType.RadioButton;
                    pushed: spool-new-or-used == NewOrUsedSelection.New;
                    height: 40px;
                    text: "Full Unused";
                    pressed => { spool-new-or-used = NewOrUsedSelection.New; if !two-questions { submit(); } }
                }
                MyButton {
                    type: ButtonType.RadioButton;
                    pushed: spool-new-or-used == NewOrUsedSelection.Used;
                    height: 40px;
                    text: "Used";
                    pressed => { spool-new-or-used = NewOrUsedSelection.Used; if !two-questions { submit(); } }
                }
            }
        }

        WizardButtons {
            back-enabled: !submitting;
            next-enabled: !submitting && spool-selection != BambulabSpoolTypeSelection.None && spool-new-or-used != NewOrUsedSelection.None;
            cancel-text: "⌂ Home";
            next-clicked => {
                submit();
            }
            back-clicked => { AppState.new-tag-scan-page = NewTagScanPage.DefinitionTagScanned; }
            cancel-clicked => { AppState.control-state = ControlState.Ready; }
        }
    }
}

export component SpoolPickerPage inherits Rectangle {
    background: white;

    VerticalLayout {
        Title {
            text: AppState.new-tag-scan-tag-type == NewScannedTagType.DefinitionTag ? "Link Tag to Existing Spool" : "Blank Tag Scanned";
        }
        VerticalLayout {
            alignment: start;
            // 224px content area: 8 padding + 12 spacing + 4 rows x 40 + 44 header = 224 exactly.
            // Do not grow any of these without shrinking another (UPDATED_SCAN_PLAN.md §3).
            padding: 4px;
            spacing: 3px;
            MyText {
                height: 44px;
                wrap: word-wrap;
                text: AppState.new-tag-scan-tag-type != NewScannedTagType.DefinitionTag
                    ? "No filament data was detected on this tag. If it is a Bambu Lab or OpenPrintTag tag, lift it off and scan again."
                    : (AppState.new-tag-scan-candidates.length == 0
                        ? "No suggestions — enter a spool ID."
                        : (AppState.new-tag-scan-match-overflow > 0
                            ? "Suggested spools  +\{AppState.new-tag-scan-match-overflow} more"
                            : "Suggested spools:"));
            }

            for entry in AppState.new-tag-scan-candidates: MyButton {
                type: ButtonType.RadioButton;
                enabled: entry.blocked-reason == "";
                pushed: AppState.new-tag-scan-selected-spool-id == entry.id && !AppState.new-tag-scan-select-enter-id;
                height: 40px;
                horizontal-alignment: left;
                text-padding: 6px;
                wrap: no-wrap;
                overflow: elide;
                text: entry.blocked-reason == "" ? "\{entry.line1} — \{entry.line2}" : "\{entry.line1} — \{entry.blocked-reason}";
                pressed => {
                    AppState.new-tag-scan-selected-spool-id = entry.id;
                    AppState.new-tag-scan-select-enter-id = false;
                }
            }

            MyButton {
                type: ButtonType.RadioButton;
                pushed: AppState.new-tag-scan-select-enter-id;
                height: 40px;
                horizontal-alignment: left;
                text-padding: 6px;
                text: "Enter Spool ID…";
                pressed => {
                    AppState.new-tag-scan-select-enter-id = true;
                    AppState.new-tag-scan-selected-spool-id = "";
                }
            }
        }

        WizardButtons {
            back-enabled: AppState.new-tag-scan-tag-type == NewScannedTagType.DefinitionTag; // page 1 exists only for definition tags
            next-enabled: AppState.new-tag-scan-select-enter-id || AppState.new-tag-scan-selected-spool-id != "";
            next-text: AppState.new-tag-scan-select-enter-id ? "Next ▶" : "✓ Link to Spool #\{AppState.new-tag-scan-selected-spool-id}";
            cancel-text: "⌂ Home";
            next-clicked => {
                if AppState.new-tag-scan-select-enter-id {
                    AppState.new-tag-scan-page = NewTagScanPage.SpoolSelect;
                } else {
                    AppState.request-link-tag-to-spool(AppState.new-tag-scan-selected-spool-id);
                }
            }
            back-clicked => { AppState.new-tag-scan-page = NewTagScanPage.DefinitionTagScanned; }
            cancel-clicked => { AppState.control-state = ControlState.Ready; }
        }
    }
}

export component SpoolSelectStep inherits Rectangle {
    background: white;
    VerticalLayout {
        Title {
            text: "Enter Spool Id";
        }
        Rectangle {
            vertical-stretch: 1;
            num-pad := NumPad {
                number: AppState.new-tag-scan-spool-id-int;
                ok-visible: false;
                display-postfix: "";
            }
        }

        WizardButtons {
            back-enabled: true;
            next-enabled: true;
            cancel-text: "⌂ Home";
            back-clicked => {
                AppState.new-tag-scan-page = NewTagScanPage.SpoolPicker;
            }
            cancel-clicked => {
                AppState.control-state = ControlState.Ready;
            }
            next-clicked => {
                num-pad.display-error = AppBackend.can-link-spool-to-tag(num-pad.number, AppState.new-tag-scan-tag-id);
                if num-pad.display-error == "" {
                    AppState.new-tag-scan-spool-id = num-pad.number;
                    AppState.new-tag-scan-spool-id-int = num-pad.number;
                    AppState.new-tag-scan-page = NewTagScanPage.SpoolDisplay;
                }
            }
        }
    }
}

export component SpoolDisplayStep inherits Rectangle {
    in-out property <string> cancel-text: "⌂ Home";
    in-out property <string> next-text: "✓ Link Tag";
    in property <UiSpoolRecordDisplay> spool-display;
    // Guards against a second tap while the link is in flight. Re-armed on entry so that
    // returning here via Back from ConfirmTagMismatch leaves live buttons (§8.3).
    property <bool> submitting: false;

    init => {
        submitting = false;
    }
    VerticalLayout {
        SpoolDisplay {
            show-title: true;
            spool-display: root.spool-display;
            title: "";
            mode: SpoolDisplayMode.Normal;
        }
        WizardButtons {
            back-enabled: !submitting;
            next-enabled: !submitting;
            cancel-enabled: true;
            cancel-text: root.cancel-text;
            next-text: root.next-text;
            back-clicked => {
                AppState.new-tag-scan-page = NewTagScanPage.SpoolSelect;
            }
            next-clicked => {
                submitting = true;
                AppState.request-link-tag-to-spool(AppState.new-tag-scan-spool-id);
            }
            cancel-clicked => {
                AppState.control-state = ControlState.Ready;
            }
        }
    }
}

export component V1TagPromptStep inherits Rectangle {
    property <NewTagOperation> selected-operation: None;
    property <bool> last-step: !AppState.is-scale-usable-now();
    function pressed(operation: NewTagOperation) {
        selected-operation = selected-operation == operation ? NewTagOperation.None : operation;
    }
    background: white;
    VerticalLayout {
        Title {
            text: "Early Version Tag That's Not in Inventory";
        }

        VerticalLayout {
            alignment: start;
            padding: 5px;
            spacing: 5px;
            MyText {
                text: "This scanned tag is from an earlier SpoolEase version and isn’t in your inventory.";
                wrap: word-wrap;
            }

            MyText {
                text: "Please choose an action:";
            }

            b1 := MyButton {
                type: ButtonType.RadioButton;
                pushed: selected-operation == NewTagOperation.AddV1TagToInventory;
                height: 56px;
                text: "Add Spool Data to Inventory";
                pressed => {
                    pressed(NewTagOperation.AddV1TagToInventory);
                }
            }

            b2 := MyButton {
                pushed: selected-operation == NewTagOperation.EraseV1Tag;
                type: ButtonType.RadioButton;
                height: 56px;
                text: "Erase Tag to Use it Without the Data";
                pressed => {
                    pressed(NewTagOperation.EraseV1Tag);
                }
            }
        }

        WizardButtons {
            back-enabled: false;
            next-enabled: selected-operation != NewTagOperation.None;
            cancel-enabled: true;
            cancel-clicked => {
                AppState.control-state = ControlState.Ready;
            }
            next-clicked => {
                if selected-operation == NewTagOperation.AddV1TagToInventory {
                    AppBackend.add-v1-tag-to-inventory(AppState.new-tag-scan-tag-id, AppState.new-tag-scan-definition-info, last-step);
                } else {
                    AppState.erase-tag-by-tag-id-start(AppState.new-tag-scan-tag-id);
                }
            }
        }
    }
}

export component WeighNewSpoolPage inherits Rectangle {
    background: white;
    property <bool> skip: false;
    property <bool> low-weight-confirmed: false;
    property <bool> submitting: false;
    property <bool> busy: submitting || AppState.new-tag-scan-discarding;
    property <bool> stable-weight: AppState.spool-scale-state == SpoolScaleState.Loaded && AppState.spool-scale-weight-stable;

    VerticalLayout {
        Title {
            text: "Spool #\{AppState.new-tag-scan-spool-id} Added";
        }
        VerticalLayout {
            alignment: start;
            padding: 5px;
            spacing: 5px;

            MyText {
                text: AppState.new-tag-scan-last-result;
                color: green;
            }

            MyText {
                wrap: word-wrap;
                text: AppState.spool-scale-state == SpoolScaleState.Uncalibrated
                    ? "Scale is not calibrated — skip weighing, or calibrate it first."
                    : (AppState.spool-scale-state == SpoolScaleState.Unknown
                        ? "Waiting for the scale… place the spool on it, or skip weighing."
                        : "Place the spool on the scale.");
            }

            Rectangle {
                height: 60px;
                ScaleWeightDisplay {
                    width: 160px;
                    weight-display-content: WeightDisplayContent.Gross;
                }
            }

            // "Weigh Spool" is the highlighted default, so Next alone accepts it. "Skip Weighing"
            // is the whole of its answer, so it acts on tap. Recording a weight can't act on tap -
            // it has to wait for a stable reading - so that one stays on Next.
            HorizontalLayout {
                spacing: -1px;
                MyButton {
                    type: ButtonType.RadioButton;
                    pushed: !skip;
                    height: 40px;
                    enabled: !busy;
                    text: "Weigh Spool";
                    pressed => {
                        skip = false;
                        low-weight-confirmed = false;
                    }
                }
                MyButton {
                    type: ButtonType.RadioButton;
                    pushed: skip;
                    height: 40px;
                    enabled: !busy;
                    text: "Skip Weighing";
                    pressed => {
                        skip = true;
                        AppState.new-tag-scan-last-result = "Weighing skipped";
                        AppState.new-tag-scan-page = NewTagScanPage.LinkAnotherTag;
                    }
                }
            }

            if !skip && stable-weight && AppState.spool-scale-weight < 100: MyText {
                text: "Only \{AppState.spool-scale-weight}g on scale — is spool on it? Press Next again to accept.";
                color: orange;
                wrap: word-wrap;
            }
        }
        WizardButtons {
            // Back undoes the import that created this spool, so it is honest to offer it.
            back-enabled: !busy;
            next-enabled: !busy && stable-weight;
            next-text: "✓ Record Weight ▶";
            cancel-text: "⌂ Home";
            back-clicked => {
                AppState.request-discard-imported-spool();
            }
            next-clicked => {
                if AppState.spool-scale-weight < 100 && !low-weight-confirmed {
                    low-weight-confirmed = true;
                } else {
                    submitting = true;
                    AppBackend.set-spool-weight(
                        AppState.new-tag-scan-spool-id,
                        AppState.spool-scale-weight,
                        AppState.new-tag-scan-spool-is-full ? AppState.spool-scale-weight : -1,
                        false
                    );
                }
            }
            cancel-clicked => { AppState.control-state = ControlState.Ready; }
        }
    }
}

export component LinkAnotherTagPage inherits Rectangle {
    background: white;

    VerticalLayout {
        Title {
            text: "Spool #\{AppState.new-tag-scan-spool-id} Ready";
        }
        VerticalLayout {
            alignment: start;
            padding: 10px;
            spacing: 8px;

            MyText {
                text: AppState.new-tag-scan-last-result;
                color: green;
            }

            MyText {
                wrap: word-wrap;
                text: AppState.new-tag-scan-extra-tag-id != ""
                    ? "Press Done to finish. Scanning any further tag starts a new spool."
                    : (AppState.new-tag-scan-definition-type == "Bambu Lab"
                        ? "Bambu Lab spools carry a tag on each side. Scan the tag on the other side now to link it to this spool, or press Done."
                        : "Scan another tag now to link it to this spool, or press Done.");
            }
            if AppState.new-tag-scan-extra-tag-status != "": MyText {
                text: AppState.new-tag-scan-extra-tag-status;
                color: AppState.new-tag-scan-extra-tag-success ? green : red;
                wrap: word-wrap;
            }

            MyText {
                wrap: word-wrap;
                text: "Imported data may be incomplete — review the spool in the inventory app.";
                color: gray;
            }
        }

        WizardButtons {
            // Back peels off one step at a time: the extra tag first, then the weigh step, then
            // the import itself.
            back-enabled: !AppState.new-tag-scan-discarding;
            back-text: AppState.new-tag-scan-extra-tag-id != "" ? "◀ Unlink Tag" : "";
            next-enabled: false;
            cancel-text: "✓ Done";
            back-clicked => {
                if AppState.new-tag-scan-extra-tag-id != "" {
                    AppState.request-unlink-extra-tag();
                } else if AppState.is-scale-present() {
                    AppState.new-tag-scan-page = NewTagScanPage.WeighNewSpool;
                } else {
                    AppState.request-discard-imported-spool();
                }
            }
            cancel-clicked => { AppState.control-state = ControlState.Ready; }
        }
    }
}

export component ConfirmTagMismatchPage inherits Rectangle {
    background: white;

    VerticalLayout {
        Title {
            text: "Tag Doesn't Match Spool #\{AppState.new-tag-scan-pending-spool-id}";
        }
        VerticalLayout {
            alignment: start;
            padding: 5px;
            spacing: 4px;

            MyText {
                wrap: word-wrap;
                text: AppState.new-tag-scan-pending-extra-tag-id != ""
                    ? "This second tag describes different filament than the spool you just added. Link it anyway?"
                    : "The scanned tag describes different filament. Linking keeps the spool's existing details and discards the tag's.";
            }

            HorizontalLayout {
                height: 20px;
                MyText { width: 110px; text: "Property"; }
                MyText { width: 170px; text: "Tag"; }
                MyText { width: 170px; text: "Spool #\{AppState.new-tag-scan-pending-spool-id}"; }
            }

            for diff in AppState.new-tag-scan-diffs: HorizontalLayout {
                height: 36px;
                MyText { width: 110px; text: diff.label; color: black; }
                MyText { width: 170px; text: diff.tag-value; color: darkblue; }
                MyText { width: 170px; text: diff.spool-value; color: darkgreen; }
            }
        }

        WizardButtons {
            back-enabled: true;
            next-enabled: true;
            next-text: "⚠ Link Anyway";
            cancel-text: "⌂ Home";
            next-clicked => { AppState.commit-link-tag-to-spool(); }
            back-clicked => {
                AppState.clear-pending-extra-tag();
                AppState.new-tag-scan-page = AppState.new-tag-scan-prev-page;
            }
            cancel-clicked => {
                AppState.clear-pending-extra-tag();
                AppState.control-state = ControlState.Ready;
            }
        }
    }
}

export component StatusDisplayPage inherits Rectangle {
    in-out property <bool> success: AppState.new-tag-scan-status == "";
    in-out property <string> message: self.success ? "Tag Linked to Spool Successfuly" : AppState.new-tag-scan-status;
    VerticalLayout {
        Rectangle {
            background: success ? lightgreen : red;
            MyText {
                text: message;
                color: Utils.contrasting_color(parent.background);
            }
        }

        WizardButtons {
            back-enabled: false;
            next-enabled: false;
            cancel-enabled: true;
            cancel-text: "Close";
            cancel-clicked => {
                AppState.control-state = ControlState.Ready;
            }
        }
    }
}

export component NewTagScan inherits Rectangle {
    property <UiSpoolRecordDisplay> spool-display: AppState.new-tag-scan-spool-id != ""
        ? AppBackend.get-spool-record-display(AppState.new-tag-scan-spool-id)
        : AppBackend.get-spool-tag-definition-display(
            AppState.new-tag-scan-definition-type,
            AppState.new-tag-scan-definition-info,
            AppState.new-tag-scan-empty-spool-weight);
    if AppState.new-tag-scan-page == NewTagScanPage.DefinitionTagScanned: DefinitionTagScannedPage { }
    if AppState.new-tag-scan-page == NewTagScanPage.SpoolTypeSelect: SpoolTypePage { }
    if AppState.new-tag-scan-page == NewTagScanPage.SpoolPicker: SpoolPickerPage { }
    if AppState.new-tag-scan-page == NewTagScanPage.SpoolSelect: SpoolSelectStep { }
    if AppState.new-tag-scan-page == NewTagScanPage.SpoolDisplay: SpoolDisplayStep { spool-display: root.spool-display; }
    if AppState.new-tag-scan-page == NewTagScanPage.ConfirmTagMismatch: ConfirmTagMismatchPage { }
    if AppState.new-tag-scan-page == NewTagScanPage.WeighNewSpool: WeighNewSpoolPage { }
    if AppState.new-tag-scan-page == NewTagScanPage.LinkAnotherTag: LinkAnotherTagPage { }
    if AppState.new-tag-scan-page == NewTagScanPage.UpdateWeight: update-weight-display := UpdateWeightPage {
        final-step: true;
        title: "Linking Tag Succeeded, Measure Weight";
        user-prompt: "Now is a good time to measure spool weight,\nPlease place it on the scale.";
        weight-current: spool-display.spool-record.weight-current;
        weight-new: spool-display.spool-record.weight-new;
        spool-id: spool-display.spool-record.id;
        back-enabled: false;
        cancel-text: "⌂ Home";
        cancel-clicked => {
            AppState.control-state = ControlState.PostAction;
        }
    }
    if AppState.new-tag-scan-page == NewTagScanPage.StatusDisplay: status-display := StatusDisplayPage { }
    if AppState.new-tag-scan-page == NewTagScanPage.V1TagPrompt: v1-prompt := V1TagPromptStep { }
} 
