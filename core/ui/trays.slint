import { Utils } from "utils.slint";
import { FrameworkState } from "framework/framework.slint";
import {
    AppBackend,
    AppConsts,
    AppState,
    ControlState,
    UiFilamentState,
    UiSlot,
    UiSlotGroup,
    UiSlotState,
} from "app.slint";
import { MyButton, MyText, Title } from "framework/widgets.slint";

global Helper {
    public pure function representative-color-index(color-count: int) -> int {
        if color-count <= 1 {
            return 0;
        }
        if color-count == 2 {
            return 1;
        }
        return (color-count - 1) / 2;
    }
}

component AmsButton inherits Rectangle {
    in property <UiSlotGroup> group;
    in property <int> group-index;
    in property <bool> active;
    horizontal-stretch: Math.max(group.slots.length, 1);

    function slot-with-spool(slot: UiSlot) -> bool {
        return slot.state == UiSlotState.Ready || slot.state == UiSlotState.Loading || slot.state == UiSlotState.Loaded || slot.state == UiSlotState.Unloading;
    }

    function slot-with-known-color(slot: UiSlot) -> bool {
        return slot.filament.state != UiFilamentState.Unknown;
    }

    ams-selector := Rectangle {
        height: parent.height;
        width: parent.width;
        background: active ? #bbb : white;
        border-width: active ? 4px : 1px;
        border-color: #001dff;

        HorizontalLayout {
            padding-top: 6px + (active ? 0px : 3px);
            padding-bottom: active ? 0px : 3px;
            padding-left: 6px;
            padding-right: 6px;
            spacing: 3px + (active ? 0px : 3px);

            for slot in group.slots: block := Rectangle {
                horizontal-stretch: 0;
                property <bool> slot-is-with-spool: slot-with-spool(slot);
                property <bool> slot-is-with-known-color: slot-with-known-color(slot);
                property <bool> slot-is-loaded: slot.state == UiSlotState.Loaded;
                property <bool> has-spool-id: slot.spool-id != "";
                property <int> spool-color-count: slot.spool-colors.length;
                property <int> slot-color-count: slot.filament.colors.length;
                property <bool> use-spool-colors: slot-is-with-known-color && has-spool-id && spool-color-count > 0;
                property <bool> shown-color-has-alpha: use-spool-colors ? slot.spool-has-alpha : slot.filament-has-alpha;
                property <color> representative-color: use-spool-colors ? slot.spool-colors[Helper.representative-color-index(spool-color-count)] : slot.filament.colors[Helper.representative-color-index(slot-color-count)];
                height: parent.height - parent.padding-top - parent.padding-bottom - 3px * 2;
                background: slot-is-with-known-color ? #00000000 : AppConsts.no-color;

                if slot-is-with-known-color && shown-color-has-alpha: Image {
                    image-fit: preserve;
                    horizontal-alignment: left;
                    vertical-alignment: top;
                    width: parent.width;
                    height: parent.height;
                    source: AppState.ams-color-checkerboard-bg;
                }

                if slot-is-with-known-color: HorizontalLayout {
                    width: parent.width;
                    height: parent.height;
                    spacing: 0px;
                    for stripe-color in use-spool-colors ? slot.spool-colors : slot.filament.colors: Rectangle {
                        horizontal-stretch: 1;
                        background: stripe-color;
                    }
                }

                if !slot-is-with-spool: special-cases-circle := Rectangle {
                    height: Math.min(parent.height, parent.width) - 4px;
                    width: self.height;
                    border-color: black;
                    border-width: 1px;
                    background: white;
                    border-radius: Math.min(self.width, self.height) / 2;
                }

                normal-border := Rectangle {
                    height: parent.height;
                    width: parent.width;
                    border-color: black;
                    border-width: 1px;
                    MyText {
                        text: !slot-is-with-spool ? "−" : !slot-is-with-known-color ? "?" : "✓";
                        color: self.text == "✓" ? #00000000 : !slot-is-with-spool ? black : slot-is-with-known-color ? Utils.contrasting_color(representative-color) : white;
                    }
                }

                if slot.used-in-print: in-use-border := Rectangle {
                    x: -2px;
                    y: -2px;
                    width: parent.width + 4px;
                    height: parent.height + 4px;
                    border-width: 2px;
                    border-color: black;
                }

                if slot-is-loaded: Image {
                    source: @image-url("./img/extruder.png");
                    colorize: Utils.contrasting_color(representative-color);
                }
            }
        }

        area := TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => {
                AppState.selected-internal-slot-group = group-index;
            }
        }
    }
}

component CircleStripes inherits Rectangle {
    in property <length> diameter: 100px;
    in property <string> circle-default-big-text;
    in property <bool> circle-display-weight;
    in property <[color]> colors;
    in property <color> circle-border-color;
    in property <length> circle-border-width;
    in property <string> circle-weight-display;
    in property <bool> circle-spoolstate-loaded;
    in property <bool> circle-show-checkerboard-bg: false;
    in property <bool> display-circle-color: false;

    width: diameter;
    height: diameter;
    background: transparent;
    clip: false;

    property <int> color-count: colors.length > 0 ? colors.length : 1;
    property <length> stripe-width: root.width / color-count;

    if display-circle-color && circle-show-checkerboard-bg: Image {
        image-fit: preserve;
        horizontal-alignment: left;
        vertical-alignment: top;
        width: parent.width;
        height: parent.height;
        source: AppState.circle-checkerboard-bg;
    }

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 0px;

        for c[idx] in colors: stripe := Rectangle {
            horizontal-stretch: 1;
            background: transparent;
            clip: root.color-count > 1;

            Rectangle {
                x: -idx * root.stripe-width;
                y: 0px;
                width: root.width;
                height: root.height;
                border-radius: self.width / 2;
                background: display-circle-color ? c : transparent;
                property <color> text-color: Utils.contrasting_color(c);

                if !circle-display-weight: Text {
                    text: circle-default-big-text;
                    color: text-color;
                    font-size: 60px;
                }

                if circle-display-weight: MyText {
                    text: circle-weight-display;
                    color: text-color;
                }

                if circle-spoolstate-loaded: Image {
                    y: parent.height / 2 + 15px;
                    source: @image-url("./img/extruder.png");
                    colorize: text-color;
                }
            }
        }
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: self.width / 2;
        border-width: circle-border-width;
        border-color: circle-border-color;
        background: transparent;
    }
}

component Spool inherits Rectangle {
    callback clicked;
    in-out property <UiSlot> slot;
    in property <bool> is-in-ams;

    property <bool> has-known-color: slot.filament.state != UiFilamentState.Unknown && (!is-in-ams || slot.state != UiSlotState.Empty);
    property <bool> has-spool-id: slot.spool-id != "";
    property <int> spool-color-count: slot.spool-colors.length;
    property <bool> use-spool-colors: has-spool-id && spool-color-count > 0;
    property <bool> inner-show-color: (has-known-color || has-spool-id) && slot.state != UiSlotState.Unknown && slot.state != UiSlotState.Empty && slot.state != UiSlotState.Spool && slot.state != UiSlotState.Reading;
    property <bool> outer-color-has-alpha: slot.filament-has-alpha;
    property <bool> inner-color-has-alpha: use-spool-colors ? slot.spool-has-alpha : slot.filament-has-alpha;
    property <[color]> outer-display-color: slot.filament.colors;
    property <string> circle-default-big-text: slot.state == UiSlotState.Unknown ? "?" : slot.state == UiSlotState.Empty ? "−" : slot.state == UiSlotState.Spool ? "↺" : slot.state == UiSlotState.Reading ? "↻" : "✓";
    property <bool> circle-display-weight: circle-default-big-text == "✓" && slot.weight-display != "";
    property <color> circle-border-color: Utils.contrasting_color(outer-display-color[Helper.representative-color-index(outer-display-color.length)]);
    property <string> circle-weight-display: slot.weight-display;
    property <bool> circle-spool-state-loaded: slot.state == UiSlotState.Loaded;
    property <bool> circle-show-checkerboard-bg: inner-show-color && inner-color-has-alpha;
    property <[color]> circle-colors: inner-show-color ? (has-spool-id ? slot.spool-colors : slot.filament.colors) : [#fff];
    property <[color]> outer-color: has-known-color ? (outer-color-has-alpha ? [#00000000] : slot.filament.colors) : [AppConsts.no-color];
    property <bool> need-draw-inner-color: circle-colors != outer-color;

    background: has-known-color ? transparent : AppConsts.no-color;

    if has-known-color && outer-color-has-alpha: Image {
        image-fit: preserve;
        horizontal-alignment: left;
        vertical-alignment: top;
        width: parent.width;
        height: parent.height;
        source: AppState.color-checkerboard-bg;
    }

    if has-known-color: HorizontalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 0px;
        for stripe-color in slot.filament.colors: Rectangle {
            horizontal-stretch: 1;
            background: stripe-color;
        }
    }

    VerticalLayout {
        property <length> circle-diameter: self.width - 8px;
        init => {
            if AppState.circle-checkerboard-diameter == 0 {
                let d = round(circle-diameter / 1px);
                let offset-x = round(self.padding-left / 1px);
                let offset-y = round(self.padding-top / 1px);
                if d > 0 {
                    AppState.circle-checkerboard-diameter = d;
                    AppState.circle-checkerboard-offset-x = offset-x;
                    AppState.circle-checkerboard-offset-y = offset-y;
                    AppBackend.ensure-circle-checkerboard(d, offset-x, offset-y);
                }
            }
        }
        padding-left: (self.width - circle-diameter) / 2;
        padding-right: self.padding-left;
        padding-top: 5px;
        padding-bottom: self.padding-top + 2px;
        spacing: 4px;
        property <length> circle-border-width: area.pressed ? 4px : 2px;

        CircleStripes {
            display-circle-color: need-draw-inner-color;
            diameter: circle-diameter;
            colors: circle-colors;
            circle-border-color: circle-border-color;
            circle-border-width: circle-border-width;
            circle-default-big-text: circle-default-big-text;
            circle-display-weight: circle-display-weight;
            circle-weight-display: circle-weight-display;
            circle-spoolstate-loaded: circle-spool-state-loaded;
            circle-show-checkerboard-bg: circle-show-checkerboard-bg;
        }

        material := Text {
            height: 18px;
            horizontal-alignment: center;
            font-size: 20px;
            text: has-known-color ? slot.filament.material : "??";
            color: has-known-color ? Utils.contrasting_color(root.outer-display-color[0]) : Utils.contrasting_color(root.background);
        }

        k-value := Text {
            height: 20px;
            horizontal-alignment: center;
            font-size: 20px;
            text: has-known-color ? "K " + slot.k : "";
            color: has-known-color ? Utils.contrasting_color(root.outer-display-color[0]) : Utils.contrasting_color(root.background);
        }
    }

    tray-border := Rectangle {
        border-width: area.pressed || AppState.control-state == ControlState.TraySelect || (AppState.highlight-slot-id == slot.id && AppState.highlight-tray-flash) ? 4px : 1px;
        border-color: AppState.control-state == ControlState.TraySelect ? (AppState.highlight-trays ? black : white) : self.border-width == 1px ? black : Utils.contrasting_color(has-known-color ? root.outer-display-color[0] : root.background);
    }

    if slot.tagged: tag := Rectangle {
        x: 15px;
        y: 2px;
        width: parent.width - 2 * self.x;
        height: 30px;
        background: lightgreen.darker(0.1);
        border-radius: 15px;
        border-color: darkgreen.darker(0.5);
        border-width: 1px;
        MyText {
            text: slot.spool-id;
            color: black;
        }
    }

    if slot.used-in-print: Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-color: black;
        border-width: 3px;
    }

    area := TouchArea {
        y: parent.y + 20px;
        width: parent.width;
        height: parent.height - 20px;
        clicked => {
            root.clicked();
        }
    }
}

component SlotCard inherits Rectangle {
    callback clicked;
    in-out property <UiSlot> slot;
    in property <bool> is-in-ams;

    VerticalLayout {
        padding: 0px;
        spacing: 4px;
        Spool {
            is-in-ams: is-in-ams;
            slot: root.slot;
            clicked => {
                root.clicked();
            }
            width: (FrameworkState.display-width - 4 * AppConsts.trays-spacing) / 5;
        }
    }
}

component SlotGroupPanel inherits VerticalLayout {
    callback title-clicked;
    in property <UiSlotGroup> group;
    in property <bool> is-ams: false;
    in property <bool> reserve-external-area: true;

    spacing: AppConsts.trays-spacing;

    title := HorizontalLayout {
        height: 50px;
        spacing: 2px;

        Rectangle {
            background: AppConsts.title-gradient;

            if !is-ams: Text {
                text: group.name;
                font-size: 20px;
                color: white;
            }

            Rectangle {
                border-width: 1px;
                border-color: black;
            }

            if is-ams: HorizontalLayout {
                for slot-group[idx] in AppState.internal-slot-groups: AmsButton {
                    height: parent.height;
                    group: slot-group;
                    group-index: idx;
                    active: AppState.current-internal-slot-group-index() == idx;
                }
            }

            if !is-ams: TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => {
                    root.title-clicked();
                }
            }
        }
    }

    slots := HorizontalLayout {
        alignment: center;
        spacing: AppConsts.trays-spacing;
        padding-left: 0px;
        padding-right: 0px;
        width: is-ams ? (reserve-external-area ? FrameworkState.display-width - (FrameworkState.display-width - 4 * AppConsts.trays-spacing) / 5 - AppConsts.trays-spacing : FrameworkState.display-width) : (FrameworkState.display-width - 4 * AppConsts.trays-spacing) / 5;

        for slot in group.slots: SlotCard {
            is-in-ams: is-ams;
            slot: slot;
            clicked => {
                if AppState.control-state == ControlState.TraySelect {
                    AppBackend.set-staging-to-slot(slot.id);
                } else if AppState.control-state == ControlState.Ready || AppState.control-state == ControlState.PostAction {
                    AppState.slot-selected(slot);
                }
            }
        }
    }
}

component GenericSlot inherits Rectangle {
    in property <UiSlot> slot;

    height: 52px;
    property <bool> has-known-color: slot.filament.state == UiFilamentState.Known && slot.filament.colors.length > 0;
    background: has-known-color ? #00000000 : white;
    border-width: area.pressed || (AppState.control-state == ControlState.TraySelect && AppState.curr-printer-can-configure-slot()) || slot.used-in-print ? 3px : 1px;
    border-color: slot.used-in-print ? #001dff : black;

    if has-known-color && slot.filament-has-alpha: Image {
        image-fit: preserve;
        horizontal-alignment: left;
        vertical-alignment: top;
        width: parent.width;
        height: parent.height;
        source: AppState.color-checkerboard-bg;
    }

    if has-known-color: HorizontalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 0px;
        for stripe-color in slot.filament.colors: Rectangle {
            horizontal-stretch: 1;
            background: stripe-color;
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;

        Rectangle {
            width: 68px;
            MyText {
                text: slot.name;
                horizontal-alignment: left;
                vertical-alignment: center;
                color: has-known-color ? Utils.contrasting_color(slot.filament.colors[0]) : black;
            }
        }

        Rectangle {
            MyText {
                text: slot.filament.material == "" || slot.filament.state == UiFilamentState.Unknown ? slot.state-label : slot.filament.material;
                horizontal-alignment: left;
                vertical-alignment: center;
                color: has-known-color ? Utils.contrasting_color(slot.filament.colors[0]) : black;
            }
        }

        Rectangle {
            width: AppState.control-state == ControlState.TraySelect ? 74px : 60px;
            MyText {
                text: slot.spool-id;
                horizontal-alignment: right;
                vertical-alignment: center;
                color: has-known-color ? Utils.contrasting_color(slot.filament.colors[0]) : black;
            }
        }

        if AppState.control-state != ControlState.TraySelect: MyButton {
            width: 72px;
            height: parent.height;
            text: "Untag";
            enabled: slot.spool-id != "" && AppState.curr-printer-can-unassign-slot();
            clicked => {
                AppBackend.unassign-slot(slot.id);
            }
        }

        if AppState.control-state != ControlState.TraySelect: MyButton {
            width: 70px;
            height: parent.height;
            text: "Reset";
            enabled: AppState.curr-printer-can-clear-slot();
            clicked => {
                AppBackend.reset-slot(slot.id);
            }
        }
    }

    area := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: AppState.control-state == ControlState.TraySelect && AppState.curr-printer-can-configure-slot();
        clicked => {
            AppBackend.set-staging-to-slot(slot.id);
        }
    }
}

export component BambuSlotGroups inherits HorizontalLayout {
    spacing: AppConsts.trays-spacing;

    if AppState.internal-slot-groups.length > 0: SlotGroupPanel {
        is-ams: true;
        reserve-external-area: AppState.external-slot-groups.length > 0;
        group: AppState.internal-slot-groups[AppState.current-internal-slot-group-index()];
    }

    if AppState.external-slot-groups.length > 0: SlotGroupPanel {
        is-ams: false;
        group: AppState.external-slot-groups[AppState.current-external-slot-group-index()];
        title-clicked => {
            if AppState.external-slot-groups.length > 1 {
                AppState.displayed-external-slot-group = Math.mod(AppState.displayed-external-slot-group + 1, AppState.external-slot-groups.length);
            }
        }
    }
}

export component GenericSlotGroups inherits Rectangle {
    width: FrameworkState.display-width;
    background: white;

    VerticalLayout {
        spacing: AppConsts.trays-spacing;
        for group in AppState.slot-groups: VerticalLayout {
            spacing: 2px;
            Title {
                text: group.name;
                text-color: white;
                background: AppConsts.title-gradient;
            }
            for slot in group.slots: GenericSlot {
                slot: slot;
            }
        }
    }
}
