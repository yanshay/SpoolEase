import { Utils } from "utils.slint";
import { FrameworkState } from "framework/framework.slint";
import {
    AppBackend,
    AppConsts,
    AppState,
    ControlState,
    UiFilamentState,
    UiSlot,
    UiSlotGroup,
    UiSlotState,
} from "app.slint";
import { MyButton, MyText } from "framework/widgets.slint";

export enum TrayDisplayMode { Normal, Compact }

global Helper {
    public function activate-slot(slot: UiSlot) {
        if AppState.control-state == ControlState.TraySelect {
            AppBackend.set-staging-to-slot(slot.id);
        } else if AppState.control-state == ControlState.Ready || AppState.control-state == ControlState.PostAction {
            AppState.slot-selected(slot);
        }
    }

    public pure function representative-color-index(color-count: int) -> int {
        if color-count <= 1 {
            return 0;
        }
        if color-count == 2 {
            return 1;
        }
        return (color-count - 1) / 2;
    }
}

component SlotGroupTab inherits Rectangle {
    in property <UiSlotGroup> group;
    in property <int> group-index;
    in property <bool> active;
    horizontal-stretch: Math.max(group.slots.length, 1);

    function slot-with-spool(slot: UiSlot) -> bool {
        return slot.state == UiSlotState.Ready || slot.state == UiSlotState.InTool || slot.state == UiSlotState.Loading || slot.state == UiSlotState.Loaded || slot.state == UiSlotState.Unloading;
    }

    function should-show-slot-color(slot: UiSlot) -> bool {
        return slot.state != UiSlotState.Empty && slot.filament.state != UiFilamentState.Unknown;
    }

    ams-selector := Rectangle {
        height: parent.height;
        width: parent.width;
        background: active ? #bbb : white;
        border-width: active ? 4px : 1px;
        border-color: #001dff;

        HorizontalLayout {
            padding-top: 6px + (active ? 0px : 3px);
            padding-bottom: active ? 0px : 3px;
            padding-left: 6px;
            padding-right: 6px;
            spacing: 3px + (active ? 0px : 3px);

            for slot in group.slots: block := Rectangle {
                horizontal-stretch: 0;
                property <bool> slot-is-with-spool: slot-with-spool(slot);
                property <bool> show-slot-color: should-show-slot-color(slot);
                property <bool> slot-is-loaded: slot.state == UiSlotState.Loaded;
                property <bool> has-spool-id: slot.spool-id != "";
                property <int> spool-color-count: slot.spool-colors.length;
                property <int> slot-color-count: slot.filament.colors.length;
                property <bool> use-spool-colors: show-slot-color && has-spool-id && spool-color-count > 0;
                property <bool> shown-color-has-alpha: use-spool-colors ? slot.spool-has-alpha : slot.filament-has-alpha;
                property <color> representative-color: use-spool-colors ? slot.spool-colors[Helper.representative-color-index(spool-color-count)] : slot.filament.colors[Helper.representative-color-index(slot-color-count)];
                height: parent.height - parent.padding-top - parent.padding-bottom - 3px * 2;
                background: show-slot-color ? #00000000 : AppConsts.no-color;

                if show-slot-color && shown-color-has-alpha: Image {
                    image-fit: preserve;
                    horizontal-alignment: left;
                    vertical-alignment: top;
                    width: parent.width;
                    height: parent.height;
                    source: AppState.ams-color-checkerboard-bg;
                }

                if show-slot-color: HorizontalLayout {
                    width: parent.width;
                    height: parent.height;
                    spacing: 0px;
                    for stripe-color in use-spool-colors ? slot.spool-colors : slot.filament.colors: Rectangle {
                        horizontal-stretch: 1;
                        background: stripe-color;
                    }
                }

                if !slot-is-with-spool: special-cases-circle := Rectangle {
                    height: Math.min(parent.height, parent.width) - 4px;
                    width: self.height;
                    border-color: black;
                    border-width: 1px;
                    background: white;
                    border-radius: Math.min(self.width, self.height) / 2;
                }

                normal-border := Rectangle {
                    height: parent.height;
                    width: parent.width;
                    border-color: black;
                    border-width: 1px;
                    MyText {
                        text: !slot-is-with-spool ? "−" : !show-slot-color ? "?" : "✓";
                        color: self.text == "✓" ? #00000000 : !slot-is-with-spool ? black : show-slot-color ? Utils.contrasting_color(representative-color) : white;
                    }
                }

                if slot.used-in-print: in-use-border := Rectangle {
                    x: -2px;
                    y: -2px;
                    width: parent.width + 4px;
                    height: parent.height + 4px;
                    border-width: 2px;
                    border-color: black;
                }

                if slot-is-loaded: Image {
                    source: @image-url("./img/extruder.png");
                    colorize: Utils.contrasting_color(representative-color);
                }
            }
        }

        area := TouchArea {
            width: parent.width;
            height: parent.height;
            clicked => {
                AppState.selected-primary-slot-group = group-index;
            }
        }
    }
}

component CircleStripes inherits Rectangle {
    in property <length> diameter: 100px;
    in property <string> circle-default-big-text;
    in property <bool> circle-display-weight;
    in property <[color]> colors;
    in property <color> circle-border-color;
    in property <length> circle-border-width;
    in property <string> circle-weight-display;
    in property <bool> circle-spoolstate-loaded;
    in property <bool> circle-show-checkerboard-bg: false;
    in property <bool> display-circle-color: false;

    width: diameter;
    height: diameter;
    background: transparent;
    clip: false;

    property <int> color-count: colors.length > 0 ? colors.length : 1;
    property <length> stripe-width: root.width / color-count;

    if display-circle-color && circle-show-checkerboard-bg: Image {
        image-fit: preserve;
        horizontal-alignment: left;
        vertical-alignment: top;
        width: parent.width;
        height: parent.height;
        source: AppState.circle-checkerboard-bg;
    }

    HorizontalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 0px;

        for c[idx] in colors: stripe := Rectangle {
            horizontal-stretch: 1;
            background: transparent;
            clip: root.color-count > 1;

            Rectangle {
                x: -idx * root.stripe-width;
                y: 0px;
                width: root.width;
                height: root.height;
                border-radius: self.width / 2;
                background: display-circle-color ? c : transparent;
                property <color> text-color: Utils.contrasting_color(c);

                if !circle-display-weight && circle-default-big-text != "✓": Text {
                    text: circle-default-big-text;
                    color: text-color;
                    font-size: 60px;
                }

                if !circle-display-weight && circle-default-big-text == "✓": Image {
                    width: parent.width;
                    height: parent.height;
                    image-fit: preserve;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    source: text-color == #ffffff ? @image-url("./img/spool_white_binary_40px.png") : @image-url("./img/spool_black_binary_40px.png");
                }

                if circle-display-weight: MyText {
                    text: circle-weight-display;
                    color: text-color;
                }

                if circle-spoolstate-loaded: Image {
                    y: parent.height / 2 + 15px;
                    source: @image-url("./img/extruder.png");
                    colorize: text-color;
                }
            }
        }
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: self.width / 2;
        border-width: circle-border-width;
        border-color: circle-border-color;
        background: transparent;
    }
}

component Spool inherits Rectangle {
    callback clicked;
    in-out property <UiSlot> slot;
    in property <bool> is-in-primary-group;
    in property <TrayDisplayMode> display-mode: TrayDisplayMode.Normal;

    property <bool> has-known-color: slot.filament.state != UiFilamentState.Unknown && (!is-in-primary-group || slot.state != UiSlotState.Empty);
    property <bool> has-spool-id: slot.spool-id != "";
    property <int> spool-color-count: slot.spool-colors.length;
    property <bool> use-spool-colors: has-spool-id && spool-color-count > 0;
    property <bool> inner-show-color: (has-known-color || has-spool-id) && slot.state != UiSlotState.Unknown && slot.state != UiSlotState.Empty && slot.state != UiSlotState.Occupied && slot.state != UiSlotState.Reading;
    property <bool> outer-color-has-alpha: slot.filament-has-alpha;
    property <bool> inner-color-has-alpha: use-spool-colors ? slot.spool-has-alpha : slot.filament-has-alpha;
    property <[color]> outer-display-color: slot.filament.colors;
    property <string> circle-default-big-text: slot.state == UiSlotState.Unknown ? "?" : slot.state == UiSlotState.Empty ? "−" : slot.state == UiSlotState.Occupied ? "↺" : slot.state == UiSlotState.Reading ? "↻" : "✓";
    property <bool> highlight-active: AppState.highlight-slot-id == slot.id && AppState.highlight-flash;
    property <bool> circle-display-weight: circle-default-big-text == "✓" && slot.weight-display != "";
    property <color> circle-border-color: Utils.contrasting_color(outer-display-color[Helper.representative-color-index(outer-display-color.length)]);
    property <string> circle-weight-display: slot.weight-display;
    property <bool> circle-spool-state-loaded: slot.state == UiSlotState.Loaded;
    property <bool> circle-show-checkerboard-bg: inner-show-color && inner-color-has-alpha;
    property <[color]> circle-colors: inner-show-color ? (has-spool-id ? slot.spool-colors : slot.filament.colors) : [#fff];
    property <[color]> outer-color: has-known-color ? (outer-color-has-alpha ? [#00000000] : slot.filament.colors) : [AppConsts.no-color];
    property <bool> need-draw-inner-color: circle-colors != outer-color;

    background: has-known-color ? transparent : AppConsts.no-color;

    if has-known-color && outer-color-has-alpha: Image {
        image-fit: preserve;
        horizontal-alignment: left;
        vertical-alignment: top;
        width: parent.width;
        height: parent.height;
        source: AppState.color-checkerboard-bg;
    }

    if has-known-color: HorizontalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 0px;
        for stripe-color in slot.filament.colors: Rectangle {
            horizontal-stretch: 1;
            background: stripe-color;
        }
    }

    VerticalLayout {
        property <length> circle-diameter: self.width - 8px;
        init => {
            if AppState.circle-checkerboard-diameter == 0 {
                let d = round(circle-diameter / 1px);
                let offset-x = round(self.padding-left / 1px);
                let offset-y = round(self.padding-top / 1px);
                if d > 0 {
                    AppState.circle-checkerboard-diameter = d;
                    AppState.circle-checkerboard-offset-x = offset-x;
                    AppState.circle-checkerboard-offset-y = offset-y;
                    AppBackend.ensure-circle-checkerboard(d, offset-x, offset-y);
                }
            }
        }
        padding-left: (self.width - circle-diameter) / 2;
        padding-right: self.padding-left;
        padding-top: 5px;
        padding-bottom: self.padding-top + 2px;
        spacing: 4px;
        property <length> circle-border-width: area.pressed ? 4px : 2px;

        CircleStripes {
            display-circle-color: need-draw-inner-color;
            diameter: circle-diameter;
            colors: circle-colors;
            circle-border-color: circle-border-color;
            circle-border-width: circle-border-width;
            circle-default-big-text: circle-default-big-text;
            circle-display-weight: circle-display-weight;
            circle-weight-display: circle-weight-display;
            circle-spoolstate-loaded: circle-spool-state-loaded;
            circle-show-checkerboard-bg: circle-show-checkerboard-bg;
        }

        if root.display-mode == TrayDisplayMode.Normal: material := Text {
            height: 18px;
            horizontal-alignment: center;
            font-size: 20px;
            text: has-known-color ? slot.filament.material : "??";
            color: has-known-color ? Utils.contrasting_color(root.outer-display-color[0]) : Utils.contrasting_color(root.background);
        }

        if root.display-mode == TrayDisplayMode.Normal: k-value := Text {
            height: 20px;
            horizontal-alignment: center;
            font-size: 20px;
            text: has-known-color && slot.k != "" ? "K " + slot.k : "";
            color: has-known-color ? Utils.contrasting_color(root.outer-display-color[0]) : Utils.contrasting_color(root.background);
        }
    }

    if root.display-mode == TrayDisplayMode.Compact: Rectangle {
        x: 4px;
        y: parent.height - self.height - 2px;
        width: parent.width - 8px;
        height: 19px;
        background: #ffffffdd;
        border-radius: 8px;
        Text {
            y: 1px;
            height: parent.height;
            text: has-known-color ? slot.filament.material : "??";
            horizontal-alignment: center;
            vertical-alignment: center;
            font-size: 18px;
            color: black;
        }
    }

    tray-border := Rectangle {
        border-width: area.pressed || AppState.control-state == ControlState.TraySelect || root.highlight-active ? 4px : 1px;
        border-color: AppState.control-state == ControlState.TraySelect ? (AppState.highlight-all-slots ? black : white) : self.border-width == 1px ? black : Utils.contrasting_color(has-known-color ? root.outer-display-color[0] : root.background);
    }

    if slot.tagged: tag := Rectangle {
        x: 15px;
        y: 2px;
        width: parent.width - 2 * self.x;
        height: 30px;
        background: lightgreen.darker(0.1);
        border-radius: 15px;
        border-color: darkgreen.darker(0.5);
        border-width: 1px;
        MyText {
            text: slot.spool-id;
            color: black;
        }
    }

    if slot.used-in-print: Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-color: black;
        border-width: 3px;
    }

    area := TouchArea {
        y: root.display-mode == TrayDisplayMode.Compact ? 20px : parent.y + 20px;
        width: parent.width;
        height: parent.height - 20px;
        clicked => {
            root.clicked();
        }
    }
}

component SlotCard inherits Rectangle {
    callback clicked;
    in-out property <UiSlot> slot;
    in property <bool> is-in-primary-group;
    in property <TrayDisplayMode> display-mode: TrayDisplayMode.Normal;

    VerticalLayout {
        padding: 0px;
        spacing: 4px;
        Spool {
            display-mode: root.display-mode;
            is-in-primary-group: is-in-primary-group;
            slot: root.slot;
            clicked => {
                root.clicked();
            }
            width: (FrameworkState.display-width - 4 * AppConsts.trays-spacing) / 5;
        }
    }
}

component SlotGroupPanel inherits VerticalLayout {
    callback title-clicked;
    in property <UiSlotGroup> group;
    in property <bool> is-primary-group: false;
    in property <bool> reserve-external-area: true;
    in property <[UiSlotGroup]> primary-groups: AppState.primary-slot-groups;
    in property <int> primary-group-index: AppState.current-primary-slot-group-index();

    spacing: AppConsts.trays-spacing;

    title := HorizontalLayout {
        height: 50px;
        spacing: 2px;

        Rectangle {
            background: AppConsts.title-gradient;

            if !is-primary-group: Text {
                text: group.name;
                font-size: 20px;
                color: white;
            }

            Rectangle {
                border-width: 1px;
                border-color: black;
            }

            if is-primary-group: HorizontalLayout {
                for slot-group[idx] in root.primary-groups: SlotGroupTab {
                    height: parent.height;
                    group: slot-group;
                    group-index: idx;
                    active: root.primary-group-index == idx;
                }
            }

            if !is-primary-group: TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => {
                    root.title-clicked();
                }
            }
        }
    }

    slots := HorizontalLayout {
        alignment: center;
        spacing: AppConsts.trays-spacing;
        padding-left: 0px;
        padding-right: 0px;
        width: is-primary-group ? (reserve-external-area ? FrameworkState.display-width - (FrameworkState.display-width - 4 * AppConsts.trays-spacing) / 5 - AppConsts.trays-spacing : FrameworkState.display-width) : (FrameworkState.display-width - 4 * AppConsts.trays-spacing) / 5;

        for slot in group.slots: SlotCard {
            is-in-primary-group: is-primary-group;
            slot: slot;
            clicked => {
                Helper.activate-slot(slot);
            }
        }
    }
}

export component StandardSlotGroups inherits HorizontalLayout {
    spacing: AppConsts.trays-spacing;

    if AppState.slot-groups-loading: Rectangle {
        width: FrameworkState.display-width;
        height: 50px + AppConsts.trays-spacing + (FrameworkState.display-width - 4 * AppConsts.trays-spacing) / 5 + 42px;

        MyText {
            width: parent.width;
            height: parent.height;
            text: "Fetching printer information...";
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if !AppState.slot-groups-loading && AppState.primary-slot-groups.length > 0: SlotGroupPanel {
        is-primary-group: true;
        reserve-external-area: AppState.external-slot-groups.length > 0;
        group: AppState.primary-slot-groups[AppState.current-primary-slot-group-index()];
    }

    if !AppState.slot-groups-loading && AppState.external-slot-groups.length > 0: SlotGroupPanel {
        is-primary-group: false;
        group: AppState.external-slot-groups[AppState.current-external-slot-group-index()];
        title-clicked => {
            if AppState.external-slot-groups.length > 1 {
                AppState.displayed-external-slot-group = Math.mod(AppState.displayed-external-slot-group + 1, AppState.external-slot-groups.length);
            }
        }
    }
}

component ToolchangerRow inherits Rectangle {
    in property <UiSlotGroup> group;
    in property <bool> upper: false;
    in property <length> tray-width;

    for slot[idx] in group.slots: Rectangle {
        x: floor(idx / 2) * (root.tray-width + AppConsts.trays-spacing) + (root.upper ? (root.tray-width + AppConsts.trays-spacing) / 2 : 0px);
        width: root.tray-width;
        height: parent.height;
        if Math.mod(idx, 2) == (root.upper ? 1 : 0): Spool {
            width: parent.width;
            height: parent.height;
            display-mode: TrayDisplayMode.Compact;
            is-in-primary-group: true;
            slot: slot;
            clicked => { Helper.activate-slot(slot); }
        }
    }
    if root.upper && AppState.toolchanger-other-groups.length > 0: MyButton {
        x: parent.width - root.tray-width / 2;
        width: root.tray-width / 2;
        height: 50px;
        text: "AMS";
        clicked => {
            AppState.selected-primary-slot-group = 0;
            AppState.toolchanger-show-other = true;
        }
    }
}

export component BambuToolchangerSlotGroups inherits VerticalLayout {
    property <length> tray-width: (FrameworkState.display-width - 4 * AppConsts.trays-spacing) / 5;
    // Match the loaded standard slot area with two compact rows.
    property <length> compact-height: tray-width + 4px;
    property <int> other-index: AppState.selected-primary-slot-group >= 0 && AppState.selected-primary-slot-group < AppState.toolchanger-other-groups.length ? AppState.selected-primary-slot-group : 0;
    width: FrameworkState.display-width;
    // Keep the slot/control-panel split stable, including while printer data loads.
    height: 2 * compact-height + AppConsts.trays-spacing;
    if !AppState.toolchanger-show-other: VerticalLayout {
        spacing: AppConsts.trays-spacing;

        if AppState.slot-groups-loading: MyText {
            text: "Fetching printer information...";
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if !AppState.slot-groups-loading && (!AppState.toolchanger-main-group-available || AppState.toolchanger-main-group.slots.length != AppState.toolchanger-slot-count): MyText {
            text: "AMS 3H unavailable";
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if !AppState.slot-groups-loading && AppState.toolchanger-main-group-available && AppState.toolchanger-main-group.slots.length == AppState.toolchanger-slot-count: VerticalLayout {
            spacing: AppConsts.trays-spacing;
            ToolchangerRow {
                group: AppState.toolchanger-main-group;
                tray-width: root.tray-width;
                upper: true;
                height: root.compact-height;
            }
            ToolchangerRow {
                group: AppState.toolchanger-main-group;
                tray-width: root.tray-width;
                height: root.compact-height;
            }
        }

        if !AppState.slot-groups-loading && (!AppState.toolchanger-main-group-available || AppState.toolchanger-main-group.slots.length != AppState.toolchanger-slot-count) && AppState.toolchanger-other-groups.length > 0: MyButton {
            height: 50px;
            text: "Other AMS";
            clicked => {
                AppState.selected-primary-slot-group = 0;
                AppState.toolchanger-show-other = true;
            }
        }
    }

    if AppState.toolchanger-show-other && AppState.toolchanger-other-groups.length > 0: HorizontalLayout {
        spacing: AppConsts.trays-spacing;
        SlotGroupPanel {
            is-primary-group: true;
            reserve-external-area: true;
            primary-groups: AppState.toolchanger-other-groups;
            primary-group-index: root.other-index;
            group: AppState.toolchanger-other-groups[root.other-index];
        }
        MyButton {
            width: root.tray-width;
            text: "AMS\n3H";
            clicked => { AppState.toolchanger-show-other = false; }
        }
    }
}
