import { FrameworkState, OtaState, Log } from "framework/framework.slint";
import { SelectorOption } from "framework/widgets.slint";
import { SelectorOptionsList } from "framework/widgets.slint";
// Types

export enum UiSlotState { Unknown, Empty, Occupied, Reading, Ready, Loading, Unloading, Loaded }
// Occupied - Spool entered the slot but not yet processed by AMS, so not ready yet
// Ready - there is a spool, it is not loaded to the extruder now
// Loading - during the process of loading into the extruder
// Loaded - in the extruder
// Unloading - during the process of unloading from the extruder
export enum UiFilamentState { Unknown, Known }

export enum UiPrinterKind { Unknown, Bambu, Fake }

export struct Printer {
    id: string,
    name: string,
    connected: bool,
    kind: UiPrinterKind,
    can_assign_slot: bool,
    can_set_spool_id: bool,
    can_clear_slot: bool,
    can_unassign_slot: bool,
}

export enum UiSlotGroupKind { Other, InternalChanger, External, Virtual }

export struct UiFilament {
  state: UiFilamentState,
  colors: [color],
  material: string,
}

export struct UiSlot {
  id: string,
  name: string,
  state: UiSlotState,
  state-label: string,
  filament: UiFilament,
  filament-has-alpha: bool,
  spool-has-alpha: bool,
  spool-colors: [color],
  k: string,
  k-meta: string,
  tagged: bool,
  weight-display: string,
  used-in-print: bool,
  spool-id: string,
}

export struct UiSlotGroup {
  id: string,
  name: string,
  short-name: string,
  kind: UiSlotGroupKind,
  slots: [UiSlot],
}

export struct UiSpoolRecord {
    id: string,
    // tag_id: string,
    material-type: string,
    material-subtype: string,
    color-name: string,
    color-code: string,
    note: string,
    brand: string,
    weight-advertised: int,
    weight-core: int,
    weight-new: int,
    weight-current: int,
    slicer-filament: string,
    // added-time: int,
    // encode-time: int,
    added-full: bool,
    consumed-since-add: float,
    consumed-since-weight: float,
    ext-has-k: bool,
    assigned-location: string,
    actual-location: string,
}

export struct UiSpoolRecordDisplay {
  spool_record: UiSpoolRecord,
  slicer-filament-name: string,
  color: color,
  colors: [color],
  colors-has-alpha: bool,
  temp-min: int,
  temp-max: int,
  pa-line1: string,
  pa-line2: string,
  assigned-location: string,
  weight-left: string,
}

export struct UiTagDiff {
    label: string,
    tag-value: string,
    spool-value: string,
}

export struct UiSpoolMatch {
    id: string,
    line1: string,
    line2: string,
    colors: [color],
    blocked-reason: string,
}

// A stock record offered as holding the same filament as some spool or tag.
export struct UiStockMatch {
    id: string,
    line1: string,
    count: int,
}

export struct UiSlotDisplay {
  filament-title: string,
  slicer-name: string,
  color-code: string,
  temp-min: int,
  temp-max: int,
  pa: string,
  pa-meta: string,
  consumed-since-loaded: float,
  available-in-spool: float,
}

export struct Location {
  rack: int,
  rack-name: string,    
  bay: int,
  shelf: int,
  position: int,
  container: int,
  }

// Consts

export global AppConsts {
    out property <length> trays-spacing: 5px;
    out property <length> external-tray-separator: 2px;
    out property <brush> no-color: @linear-gradient(45deg, #fff 0%, #333 100%);
    out property <brush> title-gradient: @linear-gradient(135deg, #09009B 0%, #001dff 100%);
    // out property <brush> no-color: @linear-gradient(45deg, #fff 0%, #AAA 54%, #333 100%);
    // out property <brush> no-color: @linear-gradient(180deg, #fff 0%, #666 50%, #333 100%);
}

export enum ControlState {
  Booting,
  BootFailed,
  Ready,
  Reading, // can probably be colapsed into Ready as a note
  NewTagScan,
  StagingSelected, // To load
  // FilamentInformation,
  TraySelect, // for selecting a tray when loading filament from staging
  TraySelected, // just selecting tray (unrelated to previous)
  Encoding, // can probably be collapsed
  Erasing, // can probably be collapsed
  PostAction, // can probably be collapsed
}

export enum SpoolScaleState {
  NotAvailable,
  Unknown,
  Uncalibrated,
  Disconnected,
  Connected,
  Empty,
  Loaded,
}

export enum SpoolScaleSource {
  Local,
  Remote,
}

export enum StatusType {
  Normal,
  Success,
  Error
}

export enum SpoolStagingState {
  Empty,
  Scanned,
  Encoded,
  Unloaded,
  Unchanged,
}

// Functions to call rust
export global AppBackend {
    callback clear-staging();
    callback set-staging-to-slot(slot-id: string);
    callback reset-slot(slot-id: string);
    callback unassign-slot(slot-id: string);
    callback encode-tag() -> bool;
    callback read-tag-mode();
    callback web-config-web-app();
    callback select-printer(printer-id: string);
    callback select-calibration-scale-source(source: SpoolScaleSource);
    callback calibrate-scale(source: SpoolScaleSource, weight: int);
    pure callback get-connected-scale-info() -> string;
    pure callback get-available-scales-info() -> [string];
    // `deduct-stock-id` is the stock record a spool is being taken out of ("Add and Remove From
    // Stock"); empty means the import doesn't touch any stock.
    callback import-definition-tag-to-inventory(tag-id: string, tag-definition-type: string, tag-definition-info: string, empty-spool-weight: int, spool-is-full: bool, deduct-stock-id: string);
    // Undo of the above: deletes the record it created, frees its auto-linked tag, clears staging.
    // `restore-stock-id` puts back the spool the import took out of that stock; "" if it took none.
    callback discard-imported-spool(spool-id: string, restore-stock-id: string);
    callback link-tag-to-untagged-spool-id(tag_id: string, tag_type: string, spool-id: string, final-step: bool);
    callback link-tag-to-tagged-spool-id(tag_id: string, tag_type: string, spool-id: string, final-step: bool);
    callback unlink-spool-from-all-tags(spool-id: string);
    callback unlink-scanned-tag-from-spool(spool-id: string);
    // New-tag-scan only: the single extra tag the user may link on the final page.
    callback link-extra-tag-to-spool(tag-id: string, tag-type: string, spool-id: string);
    callback unlink-tag-from-spool(tag-id: string, spool-id: string);
    // Reverts the last quick-weight update - the Undo button on its message box.
    callback undo-spool-weight();
    callback set-spool-weight(spool-id: string, weight_current: int, weight_new: int, final-step: bool);
    pure callback get-spool-record-display(spool-id: string) -> UiSpoolRecordDisplay;
    pure callback get-spool-tag-definition-display(tag-definition-type: string, tag-definition-info: string, empty-spool-weight: int) -> UiSpoolRecordDisplay;
    callback can-link-spool-to-tag(spool-id: string, tag-id: string) -> string;
    pure callback default-spool-type-is-low-temp(tag-definition-type: string, tag-definition-info: string) -> bool;
    callback tag-spool-differences(tag-definition-type: string, tag-definition-info: string, spool-id: string) -> [UiTagDiff];
    pure callback get-slot-display(slot-id: string) -> UiSlotDisplay;
    pure callback spool-tag-count(spool-id: string) -> int;
    pure callback staging-scanned-tag-id() -> string;
    callback add-v1-tag-to-inventory(tag_id: string, tag_descriptor: string, final-step: bool);
    callback erase-tag(tag_id: string) -> bool;
    callback erase-staging-tag() -> bool;
    callback configure-slot-with-spool-id(slot-id: string, spool-id: string);
    callback ota-check-firmwares();
    callback ota-update-firmware(product: string, train: string);
    callback encode-location-tag();
    callback update-actual-location(spool-id: string, location: string, message: string);
    pure callback storage-rack-count() -> int;
    pure callback get-storage-rack-options() -> [SelectorOption];
    pure callback storage-available-bays(rack-id: int) -> int;
    pure callback storage-available-shelves(rack-id: int, bay: int) -> int;
    pure callback storage-available-positions(rack-id: int, bay: int, shelf: int) -> int;
    pure callback storage-available-containers(rack-id: int, bay: int, shelf: int, position: int) -> int;
    pure callback storage-location-str(rack-id: int, bay: int, shelf: int, position: int, container: int) -> string;
    pure callback location-str-to-location(location-str: string) -> Location;
    callback load-staging(spool-id: string) -> string; // returns error if not found
    callback ensure-circle-checkerboard(diameter: int, offset-x: int, offset-y: int);
    // Stock records holding the same filament as a spool. `revision` is AppState.stocks-revision -
    // it is not read by rust, it is there so the bindings re-evaluate after a stock is changed.
    pure callback matching-stock-count(spool-id: string, revision: int) -> int;
    pure callback get-matching-stocks(spool-id: string, revision: int) -> [UiStockMatch];
    // Copies the spool's filament details into a new stock record holding 1 spool.
    callback create-stock-from-spool(spool-id: string);
    // Adds `delta` to a stock record's count, clamped at 0.
    callback adjust-stock-count(stock-id: string, delta: int);
    // Removes a stock record entirely. Refused by rust unless the record is stock.
    callback delete-stock(stock-id: string);
}

export enum NewScannedTagType {
  SimpleTag,
  DefinitionTag,
}

export enum NewTagScanPage {
    DefinitionTagScanned,
    SpoolTypeSelect,
    SpoolPicker,
    StockPicker,
    SpoolSelect,
    SpoolDisplay,
    ConfirmTagMismatch,
    WeighNewSpool,
    LinkAnotherTag,
    UpdateWeight,
    StatusDisplay,
    V1TagPrompt,
}

export enum NewTagOperation { None, AddV1TagToInventory, EraseV1Tag }

export enum StagingOperationsPage {
  SpoolDisplay,
  OperationSelection,
  UnlinkSelection,
  UpdateWeight,
  PlaceSpoolInAssignedLocation,
  PickSpoolFromActualLocation,
  SelectSpoolToLoad,
  ManualStorageRack,
  ManualStorageBay,
  ManualStorageShelf,
  ManualStoragePosition,
  ManualStorageContainer,
  ManualStorageComplete,
  MarkEmptyConfirm,
  TagOperations,
  Stocks
}

export struct Firmwares {
  console-curr: string,
  console-stable: string,
  console-stable-newer: bool,
  console-unstable: string,
  console-unstable-newer: bool,
  console-debug: string,
  console-debug-newer: bool,
  scale-curr: string,
  scale-stable: string,
  scale-stable-newer: bool,
  scale-unstable: string,
  scale-unstable-newer: bool,
  scale-debug: string,
  scale-debug-newer: bool,
}

export global AppState {
    in-out property <Firmwares> firmwares: {
        console-curr: "console-curr",
        console-stable: "console-stable",
        console-stable-newer: false,
        console-unstable: "console-unstable",
        console-unstable-newer: false,
        console-debug: "console-debug",
        console-debug-newer: false,
        scale-curr: "scale-curr",
        scale-stable: "scale-stable",
        scale-stable-newer: false,
        scale-unstable: "scale-unstable",
        scale-unstable-newer: false,
        scale-debug: "scale-debug",
        scale-debug-newer: false,
    };

    in-out property <string> message-box-title;
    in-out property <string> message-box-text;
    in-out property <string> message-box-text2;
    in-out property <StatusType> message-box-type;
    in-out property <int> message-box-timeout;
    in-out property <string> message-box-undo-text: ""; // "" = no undo button. Cleared by show-message-box, so set it after the call.
    in-out property <image> title-checkerboard-bg;
    in-out property <image> color-checkerboard-bg;
    in-out property <image> ams-color-checkerboard-bg;
    in-out property <image> circle-checkerboard-bg;
    in-out property <int> circle-checkerboard-diameter: 0;
    in-out property <int> circle-checkerboard-offset-x: 0;
    in-out property <int> circle-checkerboard-offset-y: 0;

    in-out property <bool> select-printer: false;
    in-out property <ControlState> control-state: ControlState.Booting;
    changed control-state => {
        self.stop-highlight-trays();
    }

    // Global state variables for New Tag Scan Control-State
    in-out property <NewScannedTagType> new-tag-scan-tag-type; // Simple (no data on tag) or Definition
    in-out property <string> new-tag-scan-tag-id: "";
    in-out property <NewTagScanPage> new-tag-scan-page: SpoolPicker;
    in-out property <string> new-tag-scan-status: ""; // text means error, empty mean ok
    in-out property <string> new-tag-scan-spool-id: "";
    in-out property <int> new-tag-scan-spool-id-int: 0; // used for when typing the id
    in-out property <string> new-tag-scan-definition-info: ""; // The actual data (as understdoon by the view_model)
    in-out property <string> new-tag-scan-definition-type: ""; // Bambu Lab, Creatlity, etc.
    in-out property <int> new-tag-scan-empty-spool-weight: 0; // 0 - not specified, value from Bambu Tag
    in-out property <bool> new-tag-scan-spool-is-full: true;
    in-out property <[UiSpoolMatch]> new-tag-scan-candidates: [];
    in-out property <int> new-tag-scan-product-match-count: 0; // full match total, for the "(N matching)" label
    in-out property <int> new-tag-scan-match-overflow: 0; // matches dropped by the row cap, for the "+N more" note
    // Stock records holding this same filament, offered as "Add and Remove From Stock".
    in-out property <[UiStockMatch]> new-tag-scan-stock-matches: [];
    in-out property <int> new-tag-scan-stock-match-count: 0; // full total, before the row cap
    // The stock the new spool is being taken out of. "" means the import touches no stock.
    in-out property <string> new-tag-scan-deduct-stock-id: "";
    in-out property <string> new-tag-scan-selected-spool-id: "";
    in-out property <bool> new-tag-scan-select-enter-id: false;
    in-out property <string> new-tag-scan-last-result: "";
    in-out property <string> new-tag-scan-extra-tag-status: "";
    in-out property <bool> new-tag-scan-extra-tag-success: false;
    // Only one extra tag may be linked on the final page; a second one starts a new scan flow.
    in-out property <string> new-tag-scan-extra-tag-id: "";
    // Set while an extra tag whose data disagrees with the spool waits on ConfirmTagMismatch.
    in-out property <string> new-tag-scan-pending-extra-tag-id: "";
    in-out property <string> new-tag-scan-pending-extra-tag-type: "";
    in-out property <[UiTagDiff]> new-tag-scan-diffs: [];
    in-out property <string> new-tag-scan-pending-spool-id: "";
    in-out property <NewTagScanPage> new-tag-scan-prev-page: SpoolPicker;
    in-out property <bool> new-tag-scan-discarding: false; // an undo (record delete) is in flight

    // Every entry into the new-tag-scan flow starts from a clean slate. A selection or a
    // definition-type left over from the previous scan would otherwise arrive pre-selected
    // and could link the new tag to the previous scan's spool.
    function reset-new-tag-scan-state() {
        self.new-tag-scan-tag-type = NewScannedTagType.SimpleTag;
        self.new-tag-scan-tag-id = "";
        self.new-tag-scan-page = NewTagScanPage.SpoolPicker;
        self.new-tag-scan-status = "";
        self.new-tag-scan-spool-id = "";
        self.new-tag-scan-spool-id-int = 0;
        self.new-tag-scan-definition-info = "";
        self.new-tag-scan-definition-type = "";
        self.new-tag-scan-empty-spool-weight = 0;
        self.new-tag-scan-spool-is-full = true;
        self.new-tag-scan-candidates = [];
        self.new-tag-scan-product-match-count = 0;
        self.new-tag-scan-match-overflow = 0;
        self.new-tag-scan-stock-matches = [];
        self.new-tag-scan-stock-match-count = 0;
        self.new-tag-scan-deduct-stock-id = "";
        self.new-tag-scan-selected-spool-id = "";
        self.new-tag-scan-select-enter-id = false;
        self.new-tag-scan-last-result = "";
        self.new-tag-scan-extra-tag-status = "";
        self.new-tag-scan-extra-tag-success = false;
        self.new-tag-scan-extra-tag-id = "";
        self.new-tag-scan-pending-extra-tag-id = "";
        self.new-tag-scan-pending-extra-tag-type = "";
        self.new-tag-scan-diffs = [];
        self.new-tag-scan-pending-spool-id = "";
        self.new-tag-scan-prev-page = NewTagScanPage.SpoolPicker;
        self.new-tag-scan-discarding = false;
    }

    public function request-link-tag-to-spool(spool-id: string) {
        self.new-tag-scan-pending-spool-id = spool-id;
        self.new-tag-scan-diffs = AppBackend.tag-spool-differences(
            self.new-tag-scan-definition-type, self.new-tag-scan-definition-info, spool-id);
        if self.new-tag-scan-diffs.length > 0 {
            self.new-tag-scan-prev-page = self.new-tag-scan-page;
            self.new-tag-scan-page = NewTagScanPage.ConfirmTagMismatch;
        } else {
            self.commit-link-tag-to-spool();
        }
    }

    public function commit-link-tag-to-spool() {
        // ConfirmTagMismatch is shared with the extra-tag path, which links a different tag to the
        // spool that is already on screen rather than the tag that opened this flow.
        if self.new-tag-scan-pending-extra-tag-id != "" {
            self.new-tag-scan-page = NewTagScanPage.LinkAnotherTag; // so the status lands as page text
            AppBackend.link-extra-tag-to-spool(self.new-tag-scan-pending-extra-tag-id,
                self.new-tag-scan-pending-extra-tag-type, self.new-tag-scan-spool-id);
            self.clear-pending-extra-tag();
            return;
        }
        self.new-tag-scan-spool-id = self.new-tag-scan-pending-spool-id;
        if AppBackend.spool-tag-count(self.new-tag-scan-pending-spool-id) > 0 {
            AppBackend.link-tag-to-tagged-spool-id(self.new-tag-scan-tag-id,
                self.new-tag-scan-definition-type, self.new-tag-scan-pending-spool-id,
                !self.is-scale-usable-now());
        } else {
            AppBackend.link-tag-to-untagged-spool-id(self.new-tag-scan-tag-id,
                self.new-tag-scan-definition-type, self.new-tag-scan-pending-spool-id,
                !self.is-scale-usable-now());
        }
    }

    public function clear-pending-extra-tag() {
        self.new-tag-scan-pending-extra-tag-id = "";
        self.new-tag-scan-pending-extra-tag-type = "";
    }

    // Rust calls this when the extra tag scanned on the final page describes different filament
    // than the spool it would join. Same confirmation page as the main link path.
    public function confirm-extra-tag-mismatch(tag-id: string, tag-type: string, diffs: [UiTagDiff]) {
        self.new-tag-scan-pending-extra-tag-id = tag-id;
        self.new-tag-scan-pending-extra-tag-type = tag-type;
        self.new-tag-scan-pending-spool-id = self.new-tag-scan-spool-id;
        self.new-tag-scan-diffs = diffs;
        self.new-tag-scan-prev-page = NewTagScanPage.LinkAnotherTag;
        self.new-tag-scan-page = NewTagScanPage.ConfirmTagMismatch;
    }

    // Back on the final page undoes the extra link before it undoes anything else.
    public function request-unlink-extra-tag() {
        AppBackend.unlink-tag-from-spool(self.new-tag-scan-extra-tag-id, self.new-tag-scan-spool-id);
    }

    public function unlink-extra-tag-status(status: string) {
        if status == "" {
            self.new-tag-scan-extra-tag-id = "";
            self.new-tag-scan-extra-tag-status = "Extra tag unlinked";
            self.new-tag-scan-extra-tag-success = true;
        } else {
            self.new-tag-scan-extra-tag-status = status;
            self.new-tag-scan-extra-tag-success = false;
        }
    }

    in-out property <StagingOperationsPage> staging-operation-page: StagingOperationsPage.OperationSelection;
    in-out property <StagingOperationsPage> prev-staging-operation-page: StagingOperationsPage.OperationSelection;
    // Bumped by rust after any stock record changes, so the stock bindings re-query the store.
    in-out property <int> stocks-revision: 0;
    in-out property <int> manual-storage-rack-id: 0;
    in-out property <string> manual-storage-rack-name: "";
    in-out property <int> manual-storage-bay: 0;
    in-out property <int> manual-storage-shelf: 0;
    in-out property <int> manual-storage-position: 0;
    in-out property <int> manual-storage-container: 0;

    // Global state for TraySelected Control-State
    in-out property <UiSlot> selected-slot;

    in-out property <SpoolStagingState> spool-staging-state: SpoolStagingState.Empty;
    in-out property <UiSpoolRecordDisplay> spool-staging-info;
    in-out property <bool> reset-staging-countdown: false;

    in-out property <string> user-message: "Booting ...";
    in-out property <StatusType> user-message-type: StatusType.Normal;

    // TODO: find a better name
    // in-out property <string> spool-inventory-dialog-message: "";
    // in-out property <StatusType> spool-inventory-dialog-type: StatusType.Normal;

    in-out property <int> encode-timeout: 999;
    in-out property <int> erase-timeout: 999;

    in-out property <bool> no-printers-configured: false;
    in-out property <int> curr-printer: -1;
    in-out property <[Printer]> available-printers: [];
    in-out property <[UiSlotGroup]> slot-groups: [];
    in-out property <[UiSlotGroup]> primary-slot-groups: [];
    in-out property <[UiSlotGroup]> external-slot-groups: [];
    in-out property <bool> slot-groups-loading: false;
    in-out property <int> selected-primary-slot-group: 0;
    in-out property <int> displayed-external-slot-group: 0;
    in-out property <int> default-printer: -1;
    in-out property <string> pending-curr-printer-id: "";
    pure public function curr-printer-name() -> string {
        if curr-printer != -1 && available-printers.length != 0 {
            return available-printers[curr-printer].name;
        } else {
            return "";
        }
    }

    pure public function curr-printer-id() -> string {
        if curr-printer != -1 && available-printers.length != 0 {
            return available-printers[curr-printer].id;
        } else {
            return "";
        }
    }

    pure public function curr-printer-connected() -> bool {
        if curr-printer != -1 && available-printers.length != 0 {
            return available-printers[curr-printer].connected;
        } else {
            return false;
        }
    }

    pure public function curr-printer-kind() -> UiPrinterKind {
        if curr-printer != -1 && available-printers.length != 0 {
            return available-printers[curr-printer].kind;
        } else {
            return UiPrinterKind.Unknown;
        }
    }

    pure public function curr-printer-is-bambu() -> bool {
        return curr-printer-kind() == UiPrinterKind.Bambu;
    }

    pure public function curr-printer-can-assign-slot() -> bool {
        if curr-printer != -1 && available-printers.length != 0 {
            return available-printers[curr-printer].can_assign_slot;
        } else {
            return false;
        }
    }

    pure public function curr-printer-can-set-spool-id() -> bool {
        if curr-printer != -1 && available-printers.length != 0 {
            return available-printers[curr-printer].can_set_spool_id;
        } else {
            return false;
        }
    }

    pure public function curr-printer-can-configure-slot() -> bool {
        return curr-printer-can-assign-slot() && curr-printer-can-set-spool-id();
    }

    pure public function curr-printer-can-clear-slot() -> bool {
        if curr-printer != -1 && available-printers.length != 0 {
            return available-printers[curr-printer].can_clear_slot;
        } else {
            return false;
        }
    }

    pure public function curr-printer-can-unassign-slot() -> bool {
        if curr-printer != -1 && available-printers.length != 0 {
            return available-printers[curr-printer].can_unassign_slot;
        } else {
            return false;
        }
    }

    pure public function current-primary-slot-group-index() -> int {
        if selected-primary-slot-group >= 0 && selected-primary-slot-group < primary-slot-groups.length {
            return selected-primary-slot-group;
        }
        return 0;
    }

    pure public function current-external-slot-group-index() -> int {
        if displayed-external-slot-group >= 0 && displayed-external-slot-group < external-slot-groups.length {
            return displayed-external-slot-group;
        }
        return 0;
    }

    changed pending-curr-printer-id => {
        if pending-curr-printer-id != "" {
            AppBackend.select-printer(pending-curr-printer-id);
            pending-curr-printer-id = "";
        }
    }

    in-out property <SpoolScaleState> spool-scale-state: SpoolScaleState.Unknown;
    in-out property <SpoolScaleSource> spool-scale-source: SpoolScaleSource.Remote;
    in-out property <bool> spool-scale-show-source: false;
    in-out property <bool> local-scale-configured: false;
    in-out property <bool> remote-scale-configured: false;
    in-out property <int> spool-scale-weight: 0;
    in-out property <bool> spool-scale-weight-stable: false;
    in-out property <int> spool-scale-raw-data: 0;
    in-out property <SpoolScaleSource> calibration-scale-source: SpoolScaleSource.Local;
    in-out property <SpoolScaleState> calibration-scale-state: SpoolScaleState.Unknown;
    in-out property <int> calibration-scale-raw-data: 0;
    in-out property <bool> spool-scale-flash: false;
    in-out property <SpoolScaleState> spool-scale-after-flash-state: SpoolScaleState.Unknown;

    in-out property <bool> highlight-trays: false;
    in-out property <bool> highlight-staging: false;
    in-out property <int> highlight-tray: -1;
    in-out property <string> highlight-slot-id: "";
    in-out property <bool> highlight-tray-flash: false;
    out property <int> highlight-tray-counter-length: 20;
    in-out property <int> highlight-tray-counter: highlight-tray-counter-length;

    public pure function ui-slot-state-name(state: UiSlotState) -> string {
        if state == UiSlotState.Unknown {
            return "Unknown";
        }
        if state == UiSlotState.Empty {
            return "Slot is Empty";
        }
        if state == UiSlotState.Occupied {
            return "Spool Placed in Slot";
        }
        if state == UiSlotState.Reading {
            return "Reading Filament Information";
        }
        if state == UiSlotState.Ready {
            return "Spool in Slot, Idle";
        }
        if state == UiSlotState.Loading {
            return "Retracting From Extruder";
        }
        if state == UiSlotState.Unloading {
            return "Loading Into Extruder";
        }
        if state == UiSlotState.Loaded {
            return "In Extruder";
        }
        return "-";
    }

    public function start-highlight-slot(slot-id: string) {
        self.highlight-slot-id = slot-id;
        self.highlight-tray-counter = highlight-tray-counter-length;
    }

    public function start-highlight-tray(tray-id: int) {
        self.highlight-tray = tray-id;
        self.highlight-slot-id = "bambu:\{tray-id}";
        self.highlight-tray-counter = highlight-tray-counter-length;
    }
    public function start-highlight-tray-forever(tray-id: int) {
        self.highlight-tray = tray-id;
        self.highlight-slot-id = "bambu:\{tray-id}";
        self.highlight-tray-counter = -1; // number even/odd to sync this tray flashing with other flashings
    }
    public function stop-highlight-tray() {
        AppState.highlight-tray = -1;
        AppState.highlight-slot-id = "";
        AppState.highlight-tray-flash = false;
        AppState.highlight-tray-counter = AppState.highlight-tray-counter-length;
    }
    public function stop-highlight-trays() {
        AppState.highlight-trays = false;
        AppState.highlight-staging = false;
    }

    // Functions called locally fom Rust

    // timeout -2 is locked, -1 is default, 0 is no timeout, positive number is timeout in seconds
    public function show-message-box(title: string, text: string, text2: string, type: StatusType, timeout: int) {
        if self.message-box-timeout == -2 && timeout != -2 {
            return;
        }
        self.message-box-undo-text = "";
        self.message-box-title = title == "" ? "Message" : title;
        self.message-box-text = text;
        self.message-box-text2 = text2;
        self.message-box-type = type;
        self.message-box-timeout = (timeout == -1 ? 10 : timeout);
    }

    public function hide-message-box() {
        self.message-box-title = "";
        self.message-box-text = "";
        self.message-box-text2 = "";
        self.message-box-type = StatusType.Normal;
        self.message-box-timeout = 0;
        self.message-box-undo-text = "";
    }

    public function initialization_completed() {
        if self.control-state == ControlState.Booting {
            self.control-state = ControlState.Ready;
        }
    }

    public function boot-failed(status: string) {
        self.control-state = ControlState.BootFailed;
        self.user-message = status;
        self.user-message-type = StatusType.Error;
    }

    public function read-tag-found() {
        if self.control-state == ControlState.Ready {
            self.control-state = ControlState.Reading;
            self.user-message = "Tag to Read Found,\nReading ...";
            self.user-message-type = StatusType.Normal;
        }
    }
    public function read-tag-failed(err-txt: string) {
        if self.control-state == ControlState.Reading {
            self.control-state = ControlState.PostAction;
            self.user-message = "Scanning Tag Failed\n\{err-txt}";
            self.user-message-type = StatusType.Error;
        }
    }
    public function read-tag-succeeded(ui-spool-info: UiSpoolRecordDisplay, final-step: bool) {
        self.spool-staging-state = SpoolStagingState.Scanned;
        self.spool-staging-info = ui-spool-info;
        self.user-message = "Tag Scanned to Staging";
        self.user-message-type = StatusType.Success;
        start-highlight-tray(999);
        if final-step {
            self.control-state = ControlState.PostAction;
        }
    }

    public function tag-unloaded(ui-spool-info: UiSpoolRecordDisplay) {
        self.spool-staging-state = SpoolStagingState.Unloaded;
        self.spool-staging-info = ui-spool-info;
        self.control-state = ControlState.PostAction;
        self.user-message = "Tag Unloaded to Staging";
        self.user-message-type = StatusType.Normal;
        start-highlight-tray(999);
    }

    public function update-spool-staging(ui-spool-info: UiSpoolRecordDisplay, state: SpoolStagingState) {
        self.spool-staging-info = ui-spool-info;
        if state != SpoolStagingState.Unchanged {
            self.spool-staging-state = state;
            start-highlight-tray(999);
        }
    }

    public function updated-spool-weight(spool-id: string, from_button: bool, prev-weight: int, new-weight: int) {
        // The new-roll flow reports the weight in the page text it lands on, so no box to dismiss.
        if !from_button && self.control-state == ControlState.NewTagScan
                        && self.new-tag-scan-page == NewTagScanPage.WeighNewSpool {
            self.new-tag-scan-last-result = "✓ Weight recorded: \{new-weight}g";
            self.new-tag-scan-page = NewTagScanPage.LinkAnotherTag;
            return;
        }
        if from_button {
            // Quick weight acts on one button press with no confirmation, so offer the way back.
            self.show-message-box("Inventory Notice", prev-weight >= 0
                ? "Updated weight from \{prev-weight}g to \{new-weight}g"
                : "Updated weight to \{new-weight}g", "Spool #\{spool-id}", StatusType.Success, -1);
            if self.message-box-timeout != -2 { // show-message-box refuses while a locked box is up
                self.message-box-undo-text = "↶ Undo";
            }
            return;
        }
        self.show-message-box("Inventory Notice", "Updated Spool \{spool-id} Weight", "", StatusType.Success, -1);
        if self.control-state == ControlState.StagingSelected || self.control-state == ControlState.NewTagScan {
            self.control-state = ControlState.Ready;
        }
    }

    public function empty-spool-staging() {
        self.spool-staging-state = SpoolStagingState.Empty;
        self.spool-staging-info = { };
        // self.spool-staging-info.spool-record.weight-core = 0;
    }

    public function spool-loaded-when-staging-loaded() {
        self.reset-staging-countdown = true;
    }

    // TODO: names are ok, but should be changed for encoding a spool-id
    public function encode-tag-found() {
        self.control-state = ControlState.Encoding;
        self.user-message = "Tag Found, Encoding ...";
        self.user-message-type = StatusType.Normal;
    }

    public function erase-tag-found() {
        self.control-state = ControlState.Erasing;
        self.user-message = "Tag Found, Erasing ...";
        self.user-message-type = StatusType.Normal;
    }

    public function encoding-failure(err-txt: string) {
        // this is just a termporary failure, not final, can still try placing tag to encode, so NOT PostAction
        self.user-message = "Encoding Tag Error\n\{err-txt}";
        self.user-message-type = StatusType.Error;
    }

    public function erasing-failure(err-txt: string) {
        // this is just a termporary failure, not final, can still try placing tag to encode, so NOT PostAction
        self.user-message = "Erasing Tag Error\n\{err-txt}";
        self.user-message-type = StatusType.Error;
    }

    public function encoding-succeeded() {
        self.control-state = ControlState.PostAction;
        self.user-message = "Encoding Succeeded";
        self.user-message-type = StatusType.Success;
    }

    public function erasing-succeeded() {
        self.control-state = ControlState.PostAction;
        self.user-message = "Erasing Succeeded";
        self.user-message-type = StatusType.Success;
    }

    public function slot-operation-failed(operation: string, configured-entity: string, err-txt: string) {
        self.control-state = ControlState.PostAction;
        self.user-message = "Failed to " + operation + "\n\{configured-entity}\n\{err-txt}";
        self.user-message-type = StatusType.Error;
    }

    public function slot-operation-succeeded(operation: string, configured-entity: string) {
        self.control-state = ControlState.PostAction;
        self.user-message = operation + " Succeeded\n\{configured-entity}";
        self.user-message-type = StatusType.Success;
    }

    public function slot-update-succeeded(operation: string, configured-entity: string, slot-id: string, printer-id: string) {
        self.control-state = ControlState.PostAction;
        self.user-message = operation + " Succeeded\n\{configured-entity}";
        self.user-message-type = StatusType.Success;
        start-highlight-slot(slot-id);
        if printer-id != "" && printer-id != self.curr-printer-id() {
            self.set-later-curr-printer(printer-id)
        }
    }

    public function staging-selected() {
        self.staging-operation-page = StagingOperationsPage.SpoolDisplay;
        self.control-state = ControlState.StagingSelected;
    }

    public function slot-selected(slot: UiSlot) {
        self.selected-slot = slot;
        self.control-state = ControlState.TraySelected;
    }

    public function prompt-select-tray() {
        self.selected-slot = { };
        AppState.control-state = ControlState.Ready;
    }

    public function manual-storage-reset() {
        self.manual-storage-rack-id = 0;
        self.manual-storage-rack-name = "";
        self.manual-storage-bay = 0;
        self.manual-storage-shelf = 0;
        self.manual-storage-position = 0;
        self.manual-storage-container = 0;
    }

    public function manual-storage-start() {
        self.manual-storage-reset();
        self.staging-operation-page = StagingOperationsPage.ManualStorageRack;
    }

    pure public function manual-storage-location-display() -> string {
        return self.manual-storage-rack-name
            + (self.manual-storage-bay > 0 ? "/B:\{self.manual-storage-bay}" : "")
            + (self.manual-storage-shelf > 0 ? "/S:\{self.manual-storage-shelf}" : "")
            + (self.manual-storage-position > 0 ? "/P:\{self.manual-storage-position}" : "")
            + (self.manual-storage-container > 0 ? "/C:\{self.manual-storage-container}" : "");
    }

    pure public function manual-storage-rack-display() -> string {
        return self.manual-storage-rack-name == "" ? "-" : self.manual-storage-rack-name;
    }

    pure public function manual-storage-bay-display() -> string {
        return self.manual-storage-bay > 0 ? "\{self.manual-storage-bay}" : "-";
    }

    pure public function manual-storage-shelf-display() -> string {
        return self.manual-storage-shelf > 0 ? "\{self.manual-storage-shelf}" : "-";
    }

    pure public function manual-storage-position-display() -> string {
        return self.manual-storage-position > 0 ? "\{self.manual-storage-position}" : "-";
    }

    pure public function manual-storage-container-display() -> string {
        return self.manual-storage-container > 0 ? "\{self.manual-storage-container}" : "-";
    }

    pure public function manual-storage-location-str() -> string {
        return AppBackend.storage-location-str(
            self.manual-storage-rack-id,
            self.manual-storage-bay,
            self.manual-storage-shelf,
            self.manual-storage-position,
            self.manual-storage-container
        );
    }

    public function manual-storage-place-here() {
        AppBackend.update-actual-location(
            self.spool-staging-info.spool-record.id,
            self.manual-storage-location-str(),
            "Updated Spool's Actual Location\nto " + self.manual-storage-location-display()
        );
        self.control-state = ControlState.Ready;
    }

    public function manual-storage-after-rack() {
        if self.manual-storage-rack-id == 0 {
            return;
        }
        let bays = AppBackend.storage-available-bays(self.manual-storage-rack-id);
        if bays <= 1 {
            self.manual-storage-bay = bays > 0 ? bays : 0;
            self.manual-storage-after-bay();
        } else {
            self.staging-operation-page = StagingOperationsPage.ManualStorageBay;
        }
    }

    public function manual-storage-after-bay() {
        let shelves = AppBackend.storage-available-shelves(self.manual-storage-rack-id, self.manual-storage-bay);
        if shelves <= 1 {
            self.manual-storage-shelf = shelves > 0 ? shelves : 0;
            self.manual-storage-after-shelf();
        } else {
            self.staging-operation-page = StagingOperationsPage.ManualStorageShelf;
        }
    }

    public function manual-storage-after-shelf() {
        let positions = AppBackend.storage-available-positions(self.manual-storage-rack-id, self.manual-storage-bay, self.manual-storage-shelf);
        if positions <= 1 {
            self.manual-storage-position = positions > 0 ? positions : 0;
            self.manual-storage-after-position();
        } else {
            self.staging-operation-page = StagingOperationsPage.ManualStoragePosition;
        }
    }

    public function manual-storage-after-position() {
        let containers = AppBackend.storage-available-containers(self.manual-storage-rack-id, self.manual-storage-bay, self.manual-storage-shelf, self.manual-storage-position);
        if containers <= 1 {
            self.manual-storage-container = containers > 0 ? containers : 0;
            self.manual-storage-after-container();
        } else {
            self.staging-operation-page = StagingOperationsPage.ManualStorageContainer;
        }
    }

    public function manual-storage-after-container() {
        self.staging-operation-page = StagingOperationsPage.ManualStorageComplete;
    }

    public function manual-storage-back-to-rack() {
        self.manual-storage-reset();
        self.staging-operation-page = StagingOperationsPage.ManualStorageRack;
    }

    public function manual-storage-back-to-bay() {
        self.manual-storage-bay = 0;
        self.manual-storage-shelf = 0;
        self.manual-storage-position = 0;
        self.manual-storage-container = 0;
        self.staging-operation-page = StagingOperationsPage.ManualStorageBay;
    }

    public function manual-storage-back-to-shelf() {
        self.manual-storage-shelf = 0;
        self.manual-storage-position = 0;
        self.manual-storage-container = 0;
        self.staging-operation-page = StagingOperationsPage.ManualStorageShelf;
    }

    public function manual-storage-back-to-position() {
        self.manual-storage-position = 0;
        self.manual-storage-container = 0;
        self.staging-operation-page = StagingOperationsPage.ManualStoragePosition;
    }

    public function manual-storage-back-from-complete() {
        if AppBackend.storage-available-containers(self.manual-storage-rack-id, self.manual-storage-bay, self.manual-storage-shelf, self.manual-storage-position) > 1 {
            self.manual-storage-container = 0;
            self.staging-operation-page = StagingOperationsPage.ManualStorageContainer;
        } else if AppBackend.storage-available-positions(self.manual-storage-rack-id, self.manual-storage-bay, self.manual-storage-shelf) > 1 {
            self.manual-storage-position = 0;
            self.manual-storage-container = 0;
            self.staging-operation-page = StagingOperationsPage.ManualStoragePosition;
        } else if AppBackend.storage-available-shelves(self.manual-storage-rack-id, self.manual-storage-bay) > 1 {
            self.manual-storage-shelf = 0;
            self.manual-storage-position = 0;
            self.manual-storage-container = 0;
            self.staging-operation-page = StagingOperationsPage.ManualStorageShelf;
        } else if AppBackend.storage-available-bays(self.manual-storage-rack-id) > 1 {
            self.manual-storage-bay = 0;
            self.manual-storage-shelf = 0;
            self.manual-storage-position = 0;
            self.manual-storage-container = 0;
            self.staging-operation-page = StagingOperationsPage.ManualStorageBay;
        } else {
            self.manual-storage-back-to-rack();
        }
    }

    // Called from UI in case of UI timeout, can also be called from backend for timeout case
    public function encoding-timeout() {
        self.control-state = ControlState.PostAction;
        self.user-message = "Encoding Tag Timed Out";
        self.user-message-type = StatusType.Error;

        AppBackend.read-tag-mode();
        // don't call encode-cancel() becasue on timeout we want to show timeout first on display
    }

    public function encode-cancel() {
        AppBackend.read-tag-mode();
        self.control-state = ControlState.Ready;
    }

    public function encode-start() {
        if AppBackend.encode-tag() { // return value of 0 means there was an error, error will be reported separately
            self.encode-timeout = 15;
            self.control-state = ControlState.Encoding;
            user-message = "Place Spool Tag\nto Encode";
            user-message-type = StatusType.Normal;
        }
    }

    public function location-encode_start() {
        AppBackend.encode-location-tag();
        self.encode-timeout = 15;
        self.control-state = ControlState.Encoding;
        user-message = "Place Location Tag\nto Encode";
        user-message-type = StatusType.Normal;
    }

    public function erasing-timeout() {
        self.control-state = ControlState.PostAction;
        self.user-message = "Erasing Tag Timed Out";
        self.user-message-type = StatusType.Error;

        AppBackend.read-tag-mode();
    }

    public function erasing-cancel() {
        AppBackend.read-tag-mode();
        self.control-state = ControlState.Ready;
    }

    public function erase-staging-tag() {
        if AppBackend.erase-staging-tag() {
            self.erase-timeout = 15;
            self.control-state = ControlState.Erasing;
            user-message = "Place Spool Tag\nto Erase";
            user-message-type = StatusType.Normal;
        }
    }

    public function erase-tag-by-tag-id-start(tag-id: string) {
        if AppBackend.erase-tag(tag-id) {
            self.erase-timeout = 15;
            self.control-state = ControlState.Erasing;
            user-message = "Place Spool Tag\nto Erase";
            user-message-type = StatusType.Normal;
        }
    }

    pure public function is-scale-usable-now() -> bool {
        return self.spool-scale-state == SpoolScaleState.Connected || self.spool-scale-state == SpoolScaleState.Empty || self.spool-scale-state == SpoolScaleState.Loaded || self.spool-scale-state == SpoolScaleState.Disconnected;
    }

    // "Is a scale configured at all", as opposed to "is it reporting a weight right now".
    // Unknown/Uncalibrated mean a scale exists but isn't usable this instant; only
    // NotAvailable means there is none. Use this for one-shot routing decisions - a
    // transient Unknown must not permanently skip a weighing step.
    pure public function is-scale-present() -> bool {
        return self.spool-scale-state != SpoolScaleState.NotAvailable;
    }

    pure public function spool-scale-source-label() -> string {
        if !self.spool-scale-show-source {
            return "";
        }
        return self.spool-scale-source == SpoolScaleSource.Local ? "Local " : "Remote ";
    }

    pure public function spool-scale-source-weight-label() -> string {
        if !self.spool-scale-show-source {
            return "";
        }
        return self.spool-scale-source == SpoolScaleSource.Local ? "Local: " : "Remote: ";
    }

    public function spool-scale-connected(source: SpoolScaleSource) {
        self.spool-scale-source = source;
        self.spool-scale-state = SpoolScaleState.Connected;
        self.spool-scale-flash = true;
        self.spool-scale-after-flash-state = SpoolScaleState.Empty;
    }

    public function spool-scale-unknown(source: SpoolScaleSource) {
        self.spool-scale-source = source;
        self.spool-scale-state = SpoolScaleState.Unknown;
        self.spool-scale-weight = 0;
        self.spool-scale-weight-stable = false;
        self.spool-scale-flash = false;
        self.spool-scale-after-flash-state = SpoolScaleState.Unknown;
    }

    public function spool-scale-not-available() {
        self.spool-scale-state = SpoolScaleState.NotAvailable;
        self.spool-scale-weight = 0;
        self.spool-scale-weight-stable = false;
        self.spool-scale-flash = false;
        self.spool-scale-after-flash-state = SpoolScaleState.NotAvailable;
    }

    public function spool-scale-disconnected(source: SpoolScaleSource) {
        self.spool-scale-source = source;
        self.spool-scale-state = SpoolScaleState.Disconnected;
        self.spool-scale-flash = false;
        self.spool-scale-after-flash-state = SpoolScaleState.Disconnected;
    }

    public function spool-scale-uncalibrated(source: SpoolScaleSource) {
        self.spool-scale-source = source;
        self.spool-scale-state = SpoolScaleState.Uncalibrated;
        self.spool-scale-flash = false;
        self.spool-scale-after-flash-state = SpoolScaleState.Uncalibrated;
    }

    public function spool-scale-loaded(source: SpoolScaleSource, weight: int, stable: bool) {
        self.spool-scale-source = source;
        self.spool-scale-state = SpoolScaleState.Loaded;
        self.spool-scale-weight = weight;
        self.spool-scale-weight-stable = stable;
        self.spool-scale-flash = true;
        self.spool-scale-after-flash-state = SpoolScaleState.Loaded;
    }

    public function spool-scale-load-changed(source: SpoolScaleSource, weight: int, stable: bool) {
        // This is only case of load changed, NOT removed
        self.spool-scale-source = source;
        self.spool-scale-weight = weight;
        self.spool-scale-weight-stable = stable;
    }

    public function spool-scale-load-removed(source: SpoolScaleSource) {
        self.spool-scale-source = source;
        self.spool-scale-state = SpoolScaleState.Empty;
        self.spool-scale-weight = 0;
        self.spool-scale-weight-stable = false;
        self.spool-scale-flash = false;
        self.spool-scale-after-flash-state = SpoolScaleState.Empty;
    }
    public function spool_scale_raw_samples_avg(source: SpoolScaleSource, raw-data: int) {
        self.spool-scale-raw-data = raw-data;
    }

    public function emulated-tag-scanned() {
    }

    public function set-printers-info(available-printers: [Printer], default_printer: int) {
        self.available-printers = available-printers;
        self.default-printer = default-printer;
    }

    public function set-curr-printer(curr-printer: int) {
        self.curr-printer = curr_printer;
    }

    // the below is a function to call with delay the select-printer
    // to avoid rust's borrowing issues in the implementation
    // uses property changed for delayed call
    public function set-later-curr-printer(printer-id: string) {
        self.pending-curr-printer-id = printer-id
    }

    // Rust callable functions for new-tag-scan flow
    public function new-tag-scanned(tag-id: string, candidates: [UiSpoolMatch]) {
        self.reset-new-tag-scan-state();
        self.new-tag-scan-tag-id = tag-id;
        self.new-tag-scan-tag-type = NewScannedTagType.SimpleTag;
        self.new-tag-scan-candidates = candidates;
        self.new-tag-scan-page = NewTagScanPage.SpoolPicker; // a blank tag can only be linked
        self.control-state = ControlState.NewTagScan;
    }
    public function new-v1-tag-scanned(tag-id: string, v1-tag: string) {
        self.reset-new-tag-scan-state();
        self.new-tag-scan-tag-id = tag-id;
        self.new-tag-scan-tag-type = NewScannedTagType.SimpleTag;
        self.new-tag-scan-definition-info = v1-tag;
        self.new-tag-scan-page = NewTagScanPage.V1TagPrompt;
        self.control-state = ControlState.NewTagScan;
    }
    public function new-definition-tag-scanned(
        definition-type: string, tag-id: string, definition-info: string,
        candidates: [UiSpoolMatch], product-match-count: int, match-overflow: int,
        stock-matches: [UiStockMatch], stock-match-count: int,
    ) {
        self.reset-new-tag-scan-state();
        self.new-tag-scan-tag-id = tag-id;
        self.new-tag-scan-tag-type = NewScannedTagType.DefinitionTag;
        self.new-tag-scan-definition-type = definition-type;
        self.new-tag-scan-definition-info = definition-info;
        self.new-tag-scan-candidates = candidates;
        self.new-tag-scan-product-match-count = product-match-count;
        self.new-tag-scan-match-overflow = match-overflow;
        self.new-tag-scan-stock-matches = stock-matches;
        self.new-tag-scan-stock-match-count = stock-match-count;
        self.new-tag-scan-page = NewTagScanPage.DefinitionTagScanned;
        self.control-state = ControlState.NewTagScan;
    }
    public function clear_tag_scanned() {
        self.reset-new-tag-scan-state();
    }

    public function import-definition-tag-to-inventory-status(status: string, spool-id: string) {
        if self.control-state == ControlState.NewTagScan {
            if status == "" {
                self.new-tag-scan-spool-id = spool-id;
                self.new-tag-scan-last-result =
                    "✓ Added \{self.new-tag-scan-spool-is-full ? "new" : "used"} spool #\{spool-id}"
                    + (self.is-scale-present() ? "" : " · no scale, weighing skipped");
                self.new-tag-scan-page = self.is-scale-present()
                    ? NewTagScanPage.WeighNewSpool
                    : NewTagScanPage.LinkAnotherTag;
            } else {
                self.new-tag-scan-page = NewTagScanPage.StatusDisplay;
                self.new-tag-scan-status = status;
            }
        }
    }

    // Back out of the pages that follow the import. Called by the page; Rust answers here.
    public function request-discard-imported-spool() {
        self.new-tag-scan-discarding = true;
        AppBackend.discard-imported-spool(self.new-tag-scan-spool-id, self.new-tag-scan-deduct-stock-id);
    }

    public function discard-imported-spool-status(status: string) {
        self.new-tag-scan-discarding = false;
        if self.control-state != ControlState.NewTagScan {
            return;
        }
        if status == "" {
            self.new-tag-scan-spool-id = "";
            self.new-tag-scan-spool-id-int = 0;
            self.new-tag-scan-last-result = "";
            self.new-tag-scan-extra-tag-status = "";
            self.new-tag-scan-extra-tag-success = false;
            self.new-tag-scan-page = NewTagScanPage.SpoolTypeSelect;
        } else {
            self.new-tag-scan-page = NewTagScanPage.StatusDisplay;
            self.new-tag-scan-status = status;
        }
    }
    public function link-tag-to-spool-id-status(status: string) {
        if self.control-state != ControlState.NewTagScan { return; }
        if self.new-tag-scan-page == NewTagScanPage.LinkAnotherTag {
            if status == "" {
                self.new-tag-scan-extra-tag-status = "✓ Second tag linked to spool #\{self.new-tag-scan-spool-id} · Back undoes it";
                self.new-tag-scan-extra-tag-success = true;
            } else {
                // Free the slot again so the user can retry with another tag.
                self.new-tag-scan-extra-tag-id = "";
                self.new-tag-scan-extra-tag-status = status;
                self.new-tag-scan-extra-tag-success = false;
            }
            return;
        }
        if status == "" {
            self.new-tag-scan-page = NewTagScanPage.UpdateWeight;
        } else {
            self.new-tag-scan-page = NewTagScanPage.StatusDisplay;
            self.new-tag-scan-status = status;
        }
    }

    public function add-v1-tag-to-inventory-status(status: string, spool-id: string) {
      // This one is called both from link_tag and from v1_tag add new tag flows
      // string empty ok, content is error message

      if self.control-state == ControlState.NewTagScan {
            if status == "" {
          // this will be effective only if there is a weight (this will be driven by the flow in the screen itself)
                self.new-tag-scan-spool-id = spool-id;
                self.new-tag-scan-page = NewTagScanPage.UpdateWeight;
            } else {
                self.new-tag-scan-page = NewTagScanPage.StatusDisplay;
                self.new-tag-scan-status = status;
            }
        }
    }

    public function unlink-spool-id-tags-status(spool-id: string, success: bool, message: string) {
        if success {
            self.show-message-box("Unlink Notice", message, "", StatusType.Success, 10);
            if self.control-state == ControlState.StagingSelected {
                self.control-state = ControlState.Ready
            }
        } else {
            self.show-message-box("Unlink Notice", message, "", StatusType.Error, 10);
        }
    }

    public function notify-available-firmwares(firmwares: Firmwares) {
        self.firmwares = firmwares;
        if FrameworkState.ota-state == OtaState.Checking {
            FrameworkState.ota-state = OtaState.UserInput;
        }
    }

    pure public function stable-firmware-updates-available() -> bool {
        return self.firmwares.console-stable-newer || self.firmwares.scale-stable-newer;
    }

    pure public function unstable-firmware-updates-available() -> bool {
        return self.firmwares.console-unstable-newer || self.firmwares.scale-unstable-newer;
    }

}
