import { MyText, MyButton, ButtonType, WizardButtons, Title, Selector } from "framework/widgets.slint";
import { AppBackend, AppState, ControlState, SpoolStagingState, SpoolScaleState, StagingOperationsPage, UiSpoolRecordDisplay } from "app.slint";
import { SpoolDisplay } from "spool-display.slint";
import { Utils } from "utils.slint";
import { ScaleWeightDisplay, LabeledText } from "app-widgets.slint";
import { UpdateWeightPage } from "common-operations.slint";
import { LocationDisplay } from "location-display.slint";
import { NumPad } from "numpad.slint";

enum UnlinkSelection {
  None,
  ScannedTag,
  AllTags,
}

component SpoolDisplayStep inherits Rectangle {
    callback more-clicked();
    in property <UiSpoolRecordDisplay> spool-display;
    VerticalLayout {

        SpoolDisplay {
            spool-display: root.spool-display;
        }

        HorizontalLayout {
            height: 56px;
            if AppState.spool-scale-state != SpoolScaleState.NotAvailable: MyButton {
                enabled: AppState.spool-staging-state != SpoolStagingState.Empty && AppState.is-scale-usable-now();
                text: "Quick Weight";
                clicked => {
                    AppBackend.set-spool-weight(spool-display.spool-record.id, AppState.spool-scale-weight, -1, false);
                }
            }

            if AppState.spool-scale-state == SpoolScaleState.NotAvailable: MyButton {
                text: "Configure Slot";
                clicked => {
                    AppState.control-state = ControlState.TraySelect;
                }
            }

            MyButton {
                text: "More...";
                clicked => {
                    AppState.staging-operation-page = StagingOperationsPage.OperationSelection;
                }
            }

            MyButton {
                text: "Close";
                clicked => {
                    AppState.prompt-select-tray();
                }
            }
        }
    }
}

component OperationSelectionStep inherits Rectangle {
    width:480px;
    height:320px;
    background: white;
    pure function linked-tag-count() -> int {
        return AppBackend.spool-tag-count(AppState.spool-staging-info.spool-record.id);
    }

    pure function unlink-button-text() -> string {
        if linked-tag-count() <= 1 {
            return "Unlink Tag";
        }
        if AppBackend.staging-scanned-tag-id() != "" {
            return "Unlink Tag/s";
        }
        return "Unlink Tags";
    }

    pure function should-show-unlink-selection() -> bool {
        return linked-tag-count() > 1 && AppBackend.staging-scanned-tag-id() != "";
    }

    VerticalLayout {
        Title {
            text: "Please Select Staging Operation";
        }

        GridLayout {
            padding: 5px;
            spacing: 5px;
            Row {
                MyButton {
                    text: "Configure Slot Manually";
                    clicked => {
                        AppState.control-state = ControlState.TraySelect;
                    }
                }

                MyButton {
                    enabled: AppState.spool-staging-state != SpoolStagingState.Empty && AppState.is-scale-usable-now();
                    text: "Advanced Weight";
                    clicked => {
                        AppState.prev-staging-operation-page = AppState.staging-operation-page;
                        AppState.staging-operation-page = StagingOperationsPage.UpdateWeight;
                    }
                }

                MyButton {
                    text: "Clear Staging";
                    clicked => {
                        AppBackend.clear-staging();
                        AppState.control-state = ControlState.Ready;
                    }
                }
            }

            Row {
                MyButton {
                    text: "Encode Tag";
                    clicked => {
                        AppState.encode-start();
                    }
                }

                MyButton {
                    text: unlink-button-text();
                    clicked => {
                        if should-show-unlink-selection() {
                            AppState.staging-operation-page = StagingOperationsPage.UnlinkSelection;
                        } else {
                            AppBackend.unlink-spool-from-all-tags(AppState.spool-staging-info.spool-record.id);
                        }
                    }
                }

                MyButton {
                    text: "Erase Tag";
                    clicked => {
                        AppState.erase-staging-tag();
                    }
                }
            }

            Row {
                MyButton {
                    visible: true;
                    enabled: AppState.spool-staging-info.spool-record.actual-location != "" || AppState.spool-staging-info.spool-record.assigned-location != "";
                    text: AppState.spool-staging-info.spool-record.actual-location != "" ? "Pick from Storage" : "Place in Assigned Spot";
                    clicked => {
                        if (AppState.spool-staging-info.spool-record.actual-location != "") {
                            AppState.staging-operation-page = StagingOperationsPage.PickSpoolFromActualLocation;
                        } else {
                            AppState.staging-operation-page = StagingOperationsPage.PlaceSpoolInAssignedLocation;
                        }
                    }
                }

                MyButton {
                    enabled: AppState.spool-staging-info.spool-record.actual-location == "" && AppBackend.storage-rack-count() > 0;
                    text: "Select Actual\nLocation";
                    clicked => {
                        AppState.manual-storage-start();
                    }
                }

                MyButton {
                    // for used up spools it needs to show "mark refilled", and start process of weighting;
                    // used up should clear the weights/fill the used, and mark it as used etc.
                    visible: false;
                    enabled: false;
                    text: "Mark Used-Up";
                }
            }
        }

        HorizontalLayout {
            MyButton {
                height: 56px;
                text: "Close";
                clicked => {
                    AppState.control-state = ControlState.Ready;
                }
            }
        }
    }
}

component UnlinkSelectionStep inherits Rectangle {
    background: white;
    property <UnlinkSelection> unlink-selection: UnlinkSelection.None;

    function pressed(selection: UnlinkSelection) {
        unlink-selection = selection;
    }

    VerticalLayout {
        Title {
            text: "Select Unlink Operation";
        }

        VerticalLayout {
            alignment: start;
            padding: 5px;
            spacing: 8px;

            MyButton {
                type: ButtonType.RadioButton;
                pushed: unlink-selection == UnlinkSelection.ScannedTag;
                height: 56px;
                text: "Unlink Scanned Tag";
                pressed => {
                    pressed(UnlinkSelection.ScannedTag);
                }
            }

            MyButton {
                type: ButtonType.RadioButton;
                pushed: unlink-selection == UnlinkSelection.AllTags;
                height: 56px;
                text: "Unlink All Linked Tags";
                pressed => {
                    pressed(UnlinkSelection.AllTags);
                }
            }
        }

        WizardButtons {
            next-enabled: unlink-selection != UnlinkSelection.None;
            back-enabled: true;
            next-clicked => {
                if unlink-selection == UnlinkSelection.ScannedTag {
                    AppBackend.unlink-scanned-tag-from-spool(AppState.spool-staging-info.spool-record.id);
                } else {
                    AppBackend.unlink-spool-from-all-tags(AppState.spool-staging-info.spool-record.id);
                }
            }
            back-clicked => {
                AppState.staging-operation-page = StagingOperationsPage.OperationSelection;
            }
            cancel-clicked => {
                AppState.control-state = ControlState.Ready;
            }
        }
    }
}

component PlacePickSpool inherits Rectangle {
    // width: 480px;
    // height: 320px;
    background: white;
    in property <UiSpoolRecordDisplay> spool-display;

    property <string> brand: spool-display.spool-record.brand == "" ? "" : "\{spool-display.spool-record.brand} ";
    property <string> material-subtype: spool-display.spool-record.material-subtype == "" ? "" : " \{spool-display.spool-record.material_subtype}";
    property <string> color-name: spool-display.spool-record.color-name == "" ? "" : " \{spool-display.spool-record.color-name}";
    property <bool> pick: AppState.staging-operation-page == StagingOperationsPage.PickSpoolFromActualLocation; // else it is place spool
    VerticalLayout {
        alignment: space-between;

        VerticalLayout {
            spacing: 10px;
            Title {
                text: pick ? "Pick Spool \{spool-display.spool-record.id} From Actual Location" : "Place Spool \{spool-display.spool-record.id} in Assigned Location";
            }

            VerticalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 10px;
                MyText {
                    vertical-stretch: 1;
                    horizontal-alignment: center;
                    text: "\{brand}\{spool-display.spool-record.material-type}\{material-subtype}\{color-name}";
                }

                MyText {
                    text: pick ? "Spool's Actual Location" : "Spool's Assigned Location";
                }

                LocationDisplay {
                    location: pick ? AppBackend.location-str-to-location(spool-display.spool-record.actual-location) : AppBackend.location-str-to-location(spool-display.spool-record.assigned-location);
                }
            }
        }

        WizardButtons {
            next-text: pick ? "Spool Picked" : "Spool Placed";
            next-enabled: true;
            back-enabled: true;
            next-clicked => {
                if pick {
                    AppBackend.update-actual-location(AppState.spool-staging-info.spool-record.id, "", "Cleared Spool's Actual Location");
                } else {
                    AppBackend.update-actual-location(AppState.spool-staging-info.spool-record.id, AppState.spool-staging-info.spool-record.assigned-location, "Updated Spool's Actual Location\nto its Assigned Location");
                }
                AppState.control-state = ControlState.Ready;
            }
            back-clicked => {
                AppState.staging-operation-page = StagingOperationsPage.OperationSelection;
            }
            cancel-clicked => {
                AppState.control-state = ControlState.Ready;
            }
        }
    }
}

component ManualStorageRackStep inherits Rectangle {
    background: white;
    VerticalLayout {
        Selector {
            vertical-stretch: 1;
            selector-title: "Select Storage Rack";
            options-list: AppBackend.get-storage-rack-options();
            selected(text, pos-in-list, id) => {
                AppState.manual-storage-reset();
                AppState.manual-storage-rack-id = id;
                AppState.manual-storage-rack-name = text;
                AppState.manual-storage-after-rack();
            }
        }

        WizardButtons {
            next-text: "Place Here";
            next-enabled: false;
            back-enabled: true;
            back-clicked => {
                AppState.staging-operation-page = StagingOperationsPage.OperationSelection;
            }
            cancel-clicked => {
                AppState.control-state = ControlState.Ready;
            }
        }
    }
}

component ManualStorageInfo inherits LabeledText {
    label-width: 155px;
}

component ManualStorageSummary inherits Rectangle {
    background: white;
    in property <length> summary-width: 180px;
    width: summary-width;
    pure function show-bay() -> bool {
        return AppBackend.storage-available-bays(AppState.manual-storage-rack-id) > 1
            && (AppState.staging-operation-page == StagingOperationsPage.ManualStorageBay
                || AppState.staging-operation-page == StagingOperationsPage.ManualStorageShelf
                || AppState.staging-operation-page == StagingOperationsPage.ManualStoragePosition
                || AppState.staging-operation-page == StagingOperationsPage.ManualStorageContainer
                || AppState.staging-operation-page == StagingOperationsPage.ManualStorageComplete);
    }

    pure function show-shelf() -> bool {
        return AppBackend.storage-available-shelves(AppState.manual-storage-rack-id, AppState.manual-storage-bay) > 1
            && (AppState.staging-operation-page == StagingOperationsPage.ManualStorageShelf
                || AppState.staging-operation-page == StagingOperationsPage.ManualStoragePosition
                || AppState.staging-operation-page == StagingOperationsPage.ManualStorageContainer
                || AppState.staging-operation-page == StagingOperationsPage.ManualStorageComplete);
    }

    pure function show-position() -> bool {
        return AppBackend.storage-available-positions(AppState.manual-storage-rack-id, AppState.manual-storage-bay, AppState.manual-storage-shelf) > 1
            && (AppState.staging-operation-page == StagingOperationsPage.ManualStoragePosition
                || AppState.staging-operation-page == StagingOperationsPage.ManualStorageContainer
                || AppState.staging-operation-page == StagingOperationsPage.ManualStorageComplete);
    }

    pure function show-container() -> bool {
        return AppBackend.storage-available-containers(AppState.manual-storage-rack-id, AppState.manual-storage-bay, AppState.manual-storage-shelf, AppState.manual-storage-position) > 1
            && (AppState.staging-operation-page == StagingOperationsPage.ManualStorageContainer
                || AppState.staging-operation-page == StagingOperationsPage.ManualStorageComplete);
    }

    VerticalLayout {
        alignment: start;
        padding-top: 3px;
        spacing: 8px;
        Rectangle {
            height: 40px;
            width: root.summary-width;
            background: skyblue;
            border-radius: self.height / 2;
            MyText {
                text: AppState.manual-storage-rack-display();
            }
        }

        if show-bay(): ManualStorageInfo {
            label: "Bay(1-\{AppBackend.storage-available-bays(AppState.manual-storage-rack-id)}):";
            text: AppState.manual-storage-bay-display();
        }

        if show-shelf(): ManualStorageInfo {
            label: "Shelf(1-\{AppBackend.storage-available-shelves(AppState.manual-storage-rack-id, AppState.manual-storage-bay)}):";
            text: AppState.manual-storage-shelf-display();
        }

        if show-position(): ManualStorageInfo {
            label: "Position(1-\{AppBackend.storage-available-positions(AppState.manual-storage-rack-id, AppState.manual-storage-bay, AppState.manual-storage-shelf)}):";
            text: AppState.manual-storage-position-display();
        }

        if show-container(): ManualStorageInfo {
            label: "Container(1-\{AppBackend.storage-available-containers(AppState.manual-storage-rack-id, AppState.manual-storage-bay, AppState.manual-storage-shelf, AppState.manual-storage-position)}):";
            text: AppState.manual-storage-container-display();
        }
    }
}

component ManualStorageNumberStep inherits Rectangle {
    background: white;
    in property <string> title;
    in property <int> max-value;
    in property <int> number;
    callback value-changed(value: int, done: bool);
    callback back-clicked;

    VerticalLayout {
        alignment: space-between;
        Title {
            text: root.title;
        }

        HorizontalLayout {
            height: root.height - 96px;
            padding-left: 5px;
            padding-right: 0px;
            spacing: 5px;
            ManualStorageSummary {
                summary-width: root.width - 298px;
            }

            NumPad {
                width: 288px;
                height: parent.height;
                number: root.number;
                min-value: 1;
                max-value: root.max-value;
                ok-visible: root.max-value >= 10;
                display-postfix: "";
                value-changed(value, done) => {
                    root.value-changed(value, done);
                }
            }
        }

        WizardButtons {
            next-text: "Place Here";
            next-enabled: AppState.manual-storage-rack-id != 0;
            back-enabled: true;
            next-clicked => {
                AppState.manual-storage-place-here();
            }
            back-clicked => {
                root.back-clicked();
            }
            cancel-clicked => {
                AppState.control-state = ControlState.Ready;
            }
        }
    }
}

component ManualStorageCompleteStep inherits Rectangle {
    background: white;
    in property <UiSpoolRecordDisplay> spool-display;
    property <string> brand: spool-display.spool-record.brand == "" ? "" : "\{spool-display.spool-record.brand} ";
    property <string> material-subtype: spool-display.spool-record.material-subtype == "" ? "" : " \{spool-display.spool-record.material_subtype}";
    property <string> color-name: spool-display.spool-record.color-name == "" ? "" : " \{spool-display.spool-record.color-name}";

    VerticalLayout {
        alignment: space-between;

        VerticalLayout {
            spacing: 10px;
            Title {
                text: "Place Spool \{spool-display.spool-record.id} in Storage";
            }

            VerticalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 10px;
                MyText {
                    vertical-stretch: 1;
                    horizontal-alignment: center;
                    text: "\{brand}\{spool-display.spool-record.material-type}\{material-subtype}\{color-name}";
                }

                MyText {
                    text: "Selected Storage Location";
                }

                LocationDisplay {
                    location: AppBackend.location-str-to-location(AppState.manual-storage-location-str());
                }
            }
        }

        WizardButtons {
            next-text: "Place Here";
            next-enabled: AppState.manual-storage-rack-id != 0;
            back-enabled: true;
            next-clicked => {
                AppState.manual-storage-place-here();
            }
            back-clicked => {
                AppState.manual-storage-back-from-complete();
            }
            cancel-clicked => {
                AppState.control-state = ControlState.Ready;
            }
        }
    }
}

component SelectSpoolToLoadStep inherits Rectangle {
    // width: 480px;
    // height: 320px;
    background: white;
    VerticalLayout {
        Title {
            text: "Enter Spool ID to Load to Staging";
        }

        Rectangle {
            num-pad := NumPad {
                number: AppState.new-tag-scan-spool-id-int;
                ok-visible: false;
                display-postfix: "";
            }
        }

        WizardButtons {
            next-text: "Load Spool";
            next-enabled: true;
            back-enabled: false;
            next-clicked => {
                num-pad.display-error = AppBackend.load-staging(num-pad.number);
                if num-pad.display-error == "" {
                    AppState.control-state = ControlState.Ready;
                }
            }
            cancel-clicked => {
                AppState.control-state = ControlState.Ready;
            }
        }
    }
}

export component StagingOperations {
    property <UiSpoolRecordDisplay> spool-display: AppBackend.get-spool-record-display(AppState.spool-staging-info.spool-record.id);
    if AppState.staging-operation-page == StagingOperationsPage.SpoolDisplay: SpoolDisplayStep {
        spool-display: spool-display;
    }
    if AppState.staging-operation-page == StagingOperationsPage.OperationSelection: OperationSelectionStep { }
    if AppState.staging-operation-page == StagingOperationsPage.UnlinkSelection: UnlinkSelectionStep { }
    if AppState.staging-operation-page == StagingOperationsPage.UpdateWeight: UpdateWeightPage {
        title: "Update Spool \{spool-display.spool-record.id} Weight";
        user-prompt: "Please place the spool on the scale:";
        weight-current: spool-display.spool-record.weight-current;
        weight-new: spool-display.spool-record.weight-new;
        spool-id: spool-display.spool-record.id;
        cancel-clicked => {
            AppState.control-state = ControlState.Ready;
        }
        back-clicked => {
            AppState.staging-operation-page = AppState.prev-staging-operation-page;
        }
    }
    if AppState.staging-operation-page == StagingOperationsPage.PlaceSpoolInAssignedLocation || AppState.staging-operation-page == StagingOperationsPage.PickSpoolFromActualLocation: PlacePickSpool {
        spool-display: spool-display;
    }
    if AppState.staging-operation-page == StagingOperationsPage.ManualStorageRack: ManualStorageRackStep { }
    if AppState.staging-operation-page == StagingOperationsPage.ManualStorageBay: ManualStorageNumberStep {
        title: "Select Bay (1-\{AppBackend.storage-available-bays(AppState.manual-storage-rack-id)})";
        max-value: AppBackend.storage-available-bays(AppState.manual-storage-rack-id);
        number: AppState.manual-storage-bay;
        value-changed(value, done) => {
            AppState.manual-storage-bay = value;
            if done {
                AppState.manual-storage-after-bay();
            }
        }
        back-clicked => {
            AppState.manual-storage-back-to-rack();
        }
    }
    if AppState.staging-operation-page == StagingOperationsPage.ManualStorageShelf: ManualStorageNumberStep {
        title: "Select Shelf (1-\{AppBackend.storage-available-shelves(AppState.manual-storage-rack-id, AppState.manual-storage-bay)})";
        max-value: AppBackend.storage-available-shelves(AppState.manual-storage-rack-id, AppState.manual-storage-bay);
        number: AppState.manual-storage-shelf;
        value-changed(value, done) => {
            AppState.manual-storage-shelf = value;
            if done {
                AppState.manual-storage-after-shelf();
            }
        }
        back-clicked => {
            AppState.manual-storage-back-to-bay();
        }
    }
    if AppState.staging-operation-page == StagingOperationsPage.ManualStoragePosition: ManualStorageNumberStep {
        title: "Select Position (1-\{AppBackend.storage-available-positions(AppState.manual-storage-rack-id, AppState.manual-storage-bay, AppState.manual-storage-shelf)})";
        max-value: AppBackend.storage-available-positions(AppState.manual-storage-rack-id, AppState.manual-storage-bay, AppState.manual-storage-shelf);
        number: AppState.manual-storage-position;
        value-changed(value, done) => {
            AppState.manual-storage-position = value;
            if done {
                AppState.manual-storage-after-position();
            }
        }
        back-clicked => {
            AppState.manual-storage-back-to-shelf();
        }
    }
    if AppState.staging-operation-page == StagingOperationsPage.ManualStorageContainer: ManualStorageNumberStep {
        title: "Select Container (1-\{AppBackend.storage-available-containers(AppState.manual-storage-rack-id, AppState.manual-storage-bay, AppState.manual-storage-shelf, AppState.manual-storage-position)})";
        max-value: AppBackend.storage-available-containers(AppState.manual-storage-rack-id, AppState.manual-storage-bay, AppState.manual-storage-shelf, AppState.manual-storage-position);
        number: AppState.manual-storage-container;
        value-changed(value, done) => {
            AppState.manual-storage-container = value;
            if done {
                AppState.manual-storage-after-container();
            }
        }
        back-clicked => {
            AppState.manual-storage-back-to-position();
        }
    }
    if AppState.staging-operation-page == StagingOperationsPage.ManualStorageComplete: ManualStorageCompleteStep {
        spool-display: spool-display;
    }
    if AppState.staging-operation-page == StagingOperationsPage.SelectSpoolToLoad: SelectSpoolToLoadStep { }
}
